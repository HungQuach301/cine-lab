 "cau_nhay_cam": [
  {
   "shot": "2k",
   "luat": "CS3 dân tộc như một khối (xem ngữ cảnh)",
   "cau": "Four days later, the French and Spanish fleets sailed in, under the Duc de Crillon:"
  },
  {
   "shot": "2k",
   "luat": "CS3 dân tộc như một khối (xem ngữ cảnh)",
   "cau": "forty-seven ships of the line by the British count, fifty by the Spanish."
  },
  {
   "shot": "2l",
   "luat": "CS3 dân tộc như một khối (xem ngữ cảnh)",
   "cau": "ten floating batteries, designed by the French engineer d'Arçon."
  },
  {
   "shot": "3a",
   "luat": "CS3 dân tộc như một khối (xem ngữ cảnh)",
   "cau": "Between the walls and the Spanish line lay a strip of sand:"
  },
  {
   "shot": "3b",
   "luat": "CS3 dân tộc như một khối (xem ngữ cảnh)",
   "cau": "With Spain's consent, the British blew up the Spanish forts."
  },
  {
   "shot": "4a",
   "luat": "CS1 (chỉ trong trích có ghi nguồn)",
   "cau": "In March 1939, Spain protested that the works stood on \"a usurped portion\" of its territory."
  },
  {
   "shot": "SM3",
   "luat": "CS1 occupied/occupation (chỉ được trong câu trích có ghi ai nói, hoặc sự kiện không về chủ quyền Gibraltar)",
   "cau": "Spain turns \"non-belligerent\" and occupies Tangier."
  }
 ],
