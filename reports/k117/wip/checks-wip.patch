+                                val=f'{len(eo)} shot eo đất · đo {len(eo) - len(th2)} · trống liên tục dài nhất {dmax:.1f} s · ' + (' · '.join(rows2) or '—'))
+    # ---- R3
+    dai = [(s, a, b) for s, a, b in eo if b - a > R3_DAI + LEN]
