+def _in(box, M):
+    H, W = M.shape; x0, y0, x1, y1 = [int(round(v * q)) for v, q in zip(box, (W, H, W, H))]
+    x0, y0 = max(0, x0), max(0, y0); x1, y1 = min(W, max(x1, x0 + 1)), min(H, max(y1, y0 + 1))
+    return bool(M[y0:y1, x0:x1].any())
