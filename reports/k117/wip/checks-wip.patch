+def _trung(b1, b2):
+    """hai hộp chuẩn hoá chồng nhau (hoặc tâm hộp này nằm trong hộp kia nở 0,02)"""
+    if not b1 or not b2: return False
+    return not (b1[2] < b2[0] - 0.02 or b2[2] < b1[0] - 0.02 or b1[3] < b2[1] - 0.02 or b2[3] < b1[1] - 0.02)
