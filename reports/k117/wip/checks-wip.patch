+                                                         + ', '.join(f"{c['hop']} {c['px']} px" for c in i['dai20_cum_lon'][:4]))
+        L['N2P-2'] += [f"(a) {w}: lỗi thời đại — {m(x)} — năm {x.get('nam')} · {str(x.get('ly_do') or '')[:80]}" for x in k['L2']]
+        nv0 += len(k['L2b'])
