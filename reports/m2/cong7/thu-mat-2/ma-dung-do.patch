+"""Cine Lab · THỬ MẶT 2 — ảnh ba cột cùng khung: v22 hiện hành | V1 | V2 (thử mặt 2). Hàng trên: cả khung 960×540 (thu 2/3); hàng dưới: cận mặt
+(khung bao mặt nạ da của bản v22, cùng ô cắt cho cả ba). Chạy: ghep3.py <gốc> <v1> <v2> <shot> <khung> <ra.jpg>
+"""
+import os, sys
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '../thu-mat'))
+from PIL import Image, ImageDraw, ImageFont
+from do_mat import bbox
+
+
+def ghep3(dirs, shot, f, out, labels=('v22 hiện hành', 'V1', 'V2 (thử mặt 2)')):
+    ims = [Image.open(f'{d}/{shot}_f{f}.png').convert('RGB') for d in dirs]
+    bb = bbox(f'{dirs[0]}/{shot}_f{f}_mask.png') or (0, 0, 960, 540)
+    W, H, Z, G = 640, 360, 640, 6
+    o = Image.new('RGB', (3 * W + 2 * G, H + G + Z), (20, 20, 20)); d = ImageDraw.Draw(o); fnt = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 18)
+    for i, (im, t) in enumerate(zip(ims, labels)):
+        x = i * (W + G); o.paste(im.resize((W, H), Image.LANCZOS), (x, 0)); o.paste(im.crop(bb).resize((Z, Z), Image.LANCZOS), (x, H + G))
+        d.rectangle([x + 4, 4, x + 11 * len(t) + 14, 30], fill=(0, 0, 0)); d.text((x + 9, 7), t, fill=(255, 255, 255), font=fnt)
+    d.text((6, H + G + 6), f'{shot} khung {f}', fill=(255, 255, 255), font=fnt)
+    o.save(out, quality=90); print(out)
+
+
+if __name__ == '__main__':
+    ghep3(sys.argv[1:4], sys.argv[4], sys.argv[5], sys.argv[6])
