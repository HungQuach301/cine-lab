+// Cine Lab · Cổng 7 THỬ MẶT 2 — BIẾN THỂ 'v2' (ứng viên thiết kế v1.5.2 + vật liệu V1 có sửa). Nhánh thu-mat-2, KHÔNG merge.
+// Bật: page.js setup({ dbg: { thuMat: 'v2' } }) (hoặc CINE_THU_MAT=v2 cho export_c3.js) → bl_head.js bật tóc thái dương, tai −10 %,
+// nếp nhăn thủ tục, vật liệu da V1 (tai bớt hồng/xuyên sáng); file này = install() của V1 (ánh dội môi trường thật, phơi sáng s03,
+// vi chuyển động) + sửa theo shot dưới đây. Không đặt cờ → không nạp file này (0 px).
+//   satCap : trần độ bão hoà (tỉ lệ (max−min)/max, tuyến tính) của phần khuếch tán da — hết "đỏ cam gắt" khi đèn khí bắt lửa (s03, s05).
+//   envD   : tỉ lệ ánh dội môi trường thật vào da (V1 = 0,3) — s05 nâng lại để mặt không chìm (V1 làm mặt tối 10 L*).
+//   expoK  : hệ số phơi sáng cả khung (máy quay) cho shot.
+import { install as installV1 } from './v1.js';
+export const SHOT2 = {
+  s03: { satCap: 0.66 },
+  s05: { satCap: 0.7, envD: 1.2, expoK: 1.35 },
+  s22: {},
+};
+export function install(ctx) {
+  const v1 = installV1(ctx); if (!v1) return null;
