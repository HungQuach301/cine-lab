@@ -0,0 +1,22 @@
+"""Cine Lab · THỬ MẶT 2 — bảng số đo da mặt v22 (goc) | V1 | V2 cho s03, s05, s22 (dùng do_mat.py của V1, cùng mặt nạ, cùng khung dải).
+s03 chỉ tính các khung SAU khi đèn bắt lửa (1,0 s và 1,5 s của dải), như V1.
+Chạy: /opt/cine/bin/python design/cong7/thu-mat-2/bang_do.py [/var/tmp/cine-out/thu-mat-2] [ra.json]
+"""
+import json, os, sys
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '../thu-mat'))
+import numpy as np
+from do_mat import do_frame
+
+R = sys.argv[1] if len(sys.argv) > 1 else '/var/tmp/cine-out/thu-mat-2'
+KH = {'s03': [228, 240], 's05': list(range(288, 384, 12)), 's22': list(range(1188, 1260, 12))}
+KEYS = ['chay_pct', 'trang_pct', 'L_tb', 'L_p5', 'L_p95', 'a_tb', 'b_tb', 'C_tb', 'C_sd']
+out = {}
+for s, fr in KH.items():
+    for v in ('goc', 'v1', 'v2'):
+        rows = [do_frame(f'{R}/dai-{v}/{s}_f{f}.png', f'{R}/dai-{v}/{s}_f{f}_mask.png') for f in fr]
+        rows = [r for r in rows if 'L_tb' in r]
+        m = {k: round(float(np.mean([r[k] for r in rows])), 1) for k in KEYS}
+        m['n_px'] = int(np.mean([r['px'] for r in rows]))
+        out[f'{s}/{v}'] = m
+        print(s, v, ' '.join(f'{k}={m[k]}' for k in KEYS), 'n_px', m['n_px'])
+if len(sys.argv) > 2: json.dump(out, open(sys.argv[2], 'w'), ensure_ascii=False, indent=1)
