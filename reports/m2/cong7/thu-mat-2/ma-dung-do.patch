+  const f0 = Math.round(r.t0 * 24), f1 = Math.round(r.t1 * 24);
+  const dai = []; for (let t = 0; t < (r.t1 - r.t0) - 1e-6; t += 0.5) dai.push(f0 + Math.round(t * 24));
+  const pick = arg('frames') ? arg('frames').split(',').map(Number) : dai;
