+#!/bin/bash
+# Cine Lab · THỬ MẶT 2 — lượt render sản phẩm (làn nặng): model sheet trước/sau, trọn shot V2 (s03, s05, s22) kèm khung dải + mặt nạ,
+# đóng gói (phụ đề như layout + dải kiểm mù), clip C3 tại /var/tmp/cine-out/thu-mat-2/<shot>.mp4.
+# Dùng: bash design/cong7/thu-mat-2/chay_tron.sh [sheet] [shots] [goi]   (không đối số = cả ba)
+set -e
+cd "$(dirname "$0")/../../.."
+O=/var/tmp/cine-out/thu-mat-2; RP=reports/m2/cong7/thu-mat-2; mkdir -p "$O/tron" "$RP"
+Q="bash scripts/render/queue.sh W-thu-mat-2"
+ALL=${*:-sheet shots goi}
+if [[ $ALL == *sheet* ]]; then
+  $Q sheet-truoc -- node design/cong7/thu-mat-2/sheet_drv.js --out "$O/sheet-truoc" --w 640 --h 640 --samples 8
+  $Q sheet-sau -- node design/cong7/thu-mat-2/sheet_drv.js --out "$O/sheet-sau" --flag v2 --w 640 --h 640 --samples 8
+fi
+if [[ $ALL == *shots* ]]; then
