+// Cine Lab · Cổng 7 THỬ MẶT 2 — driver model sheet đầu Ida.
+// node design/cong7/thu-mat-2/sheet_drv.js --out <dir> [--flag v2] [--w 640 --h 640] [--samples 8] [--views thang,nghieng] [--dist 1.55]
+// Ghi <out>/<góc>_<mu|khongmu>.png và <out>/ear.json (khung tai px, bản không mũ).
+const { chromium } = require('/opt/pw/node_modules/playwright');
+const { spawnSync } = require('child_process');
+const fs = require('fs'), path = require('path');
+const arg = (k, d) => { const i = process.argv.indexOf('--' + k); return i > 0 ? process.argv[i + 1] : d; };
+const ROOT = path.resolve(__dirname, '../..'), W = +arg('w', 640), H = +arg('h', 640), out = path.resolve(arg('out', 'out')), flag = arg('flag', null);
+let VIEWS = [['thang', 0, 0], ['3-4', 40, 0], ['nghieng', 90, 0], ['3-4-sau', 140, 0], ['sau', 180, 0], ['ngang-14', 40, -14]];
+if (arg('views')) { const w = arg('views').split(','); VIEWS = VIEWS.filter((v) => w.includes(v[0])); }
+(async () => {
+  fs.mkdirSync(out, { recursive: true });
+  const browser = await chromium.launch({ args: ['--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--ignore-gpu-blocklist'] });
+  const page = await browser.newPage({ viewport: { width: 800, height: 600 } });
+  page.on('console', (m) => { const t = m.text(); if (!/GPU stall|GL Driver|THREE.WebGLRenderer/.test(t)) console.error('[page]', t); });
+  page.on('pageerror', (e) => console.error('[pageerror]', e.message));
+  await page.route('http://cine.local/**', (route) => {
+    const p = path.join(ROOT, decodeURIComponent(new URL(route.request().url()).pathname));
+    const type = p.endsWith('.js') ? 'text/javascript' : p.endsWith('.json') ? 'application/json' : p.endsWith('.png') ? 'image/png' : 'text/html';
+    if (!fs.existsSync(p)) return route.fulfill({ status: 404, body: 'not found ' + p });
+    route.fulfill({ status: 200, contentType: type, body: fs.readFileSync(p) });
+  });
+  await page.route('http://cine.local/sheet.html', (r) => r.fulfill({ status: 200, contentType: 'text/html', body: '<!doctype html><html><body><script type="module" src="/cong7/thu-mat-2/sheet_page.js"></script></body></html>' }));
+  await page.goto('http://cine.local/sheet.html');
+  await page.waitForFunction(() => typeof window.setup === 'function', null, { timeout: 60000 });
+  await page.evaluate(async (c) => await window.setup(c), { W, H, flag, samples: +arg('samples', 8), dist: +arg('dist', 1.55) });
+  const ear = {};
+  for (const [name, yaw, pitch] of VIEWS) for (const hat of [true, false]) {
+    const b64 = await page.evaluate(async (v) => await window.renderView(v), { yaw, pitch, hat });
+    spawnSync('ffmpeg', ['-v', 'error', '-y', '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-s', `${W}x${H}`, '-i', '-', '-vf', 'vflip', '-frames:v', '1', path.join(out, `${name}_${hat ? 'mu' : 'khongmu'}.png`)], { input: Buffer.from(b64, 'base64') });
+    if (!hat) ear[name] = await page.evaluate(() => window.earBox());
+  }
+  fs.writeFileSync(path.join(out, 'ear.json'), JSON.stringify(ear, null, 1));
+  await browser.close();
+})().catch((e) => { console.error(e); process.exit(1); });
