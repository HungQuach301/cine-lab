+#!/bin/bash
+# Cổng 5 · W3 — cổng mặt Ida A3: ảnh thử 1920×1080, 3 mẫu, CHIẾU SÁNG NHƯ PHIM (yêu cầu P sau kiểm mù lần 4):
+# dựng đúng shot layout s37 (bộ cảnh cuối phố, Ida trên thang ở L11, faceCam 85 mm, khung giữa shot) qua design/cong5/mat/page_layout_fl.js,
+# chỉ ghi đè biểu cảm Ida; ánh sáng = đèn khí L11 như layout (không bóng) + facelight.js 'gas' + phơi sáng fl.exposure() + lớp vẽ FACE_PAINT (quầng sáng thấp).
+# Hai ghi đè ánh sáng/lớp vẽ này là ĐỀ XUẤT cho W2/P áp vào s36/s37/s39 (BAO-CAO-W3.md mục A3).
+# Dùng: bash design/cong5/mat/run_a3.sh <thư mục ra> [tên...]   (tên: neutral sad_smile choked nghieng; mặc định cả 4)
+set -u
+WT=/home/user/cine-lab/.claude/worktrees/agent-a83d4075f6a9542ef
+cd "$WT"; export PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
+O=${1:?}; shift; mkdir -p "$O"; NAMES=${@:-"neutral sad_smile choked nghieng"}
+L='"shot":"s37","fl":{"mode":"gas"},"expose":"auto","paint":{"halation":0.04,"bloomWide":0.02}'
+args() { case "$1" in
+  neutral|sad_smile|choked) echo "{$L,\"expr\":\"$1\"}" ;;
+  nghieng) echo "{$L,\"expr\":\"sad_smile\",\"cam\":{\"yaw\":-80,\"dist\":1.1,\"y\":-0.02}}" ;;   # mặt nghiêng (so với s31)
+  *) echo "tên ảnh lạ: $1" >&2; return 1 ;; esac; }
+for n in $NAMES; do
+  A=$(args "$n") || exit 2
+  s=$(date +%s.%N)
+  bash scripts/render/queue.sh W3 "mat-a3-$n" -- timeout 600 node design/cong5/mat/still.js --page cong5/mat/page_layout_fl.js --frame face_ida --out "$O/$n" --samples 3 --args "$A" 2>&1 | grep -iv "gpu stall" | grep -i "error\|queue" || true
+  echo "$n $(echo "$(date +%s.%N) - $s" | bc)" >> "$O/thoi-gian.txt"
+done
+echo XONG >> "$O/thoi-gian.txt"
