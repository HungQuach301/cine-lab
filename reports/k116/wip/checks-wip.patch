+    win = cv2.createHanningWindow((W, F.shape[1]), cv2.CV_32F)
+    st = max(1, int(round(step_s * fps))); per = max(1, int(round(1.0 / step_s)))
+    i0, i1 = int(np.ceil(a * fps)) + 1, int(b * fps) - 1; v = []
