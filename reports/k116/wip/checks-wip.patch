+def _logpolar(x, win, PW=1024, PH=360):
+    import cv2, numpy as np
+    h, w = x.shape; f = np.log1p(np.abs(np.fft.fftshift(np.fft.fft2(x * win)))).astype(np.float32); R = min(w, h) / 2
