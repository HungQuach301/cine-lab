+def zoom_pc(a, b, win, PW=1024):
+    """tỉ lệ phóng b so với a bằng phase correlation trên phổ biên độ log-polar (Fourier–Mellin; thử tổng hợp: sai ≤ 0,3 điểm % ở 2–5 %)"""
+    import cv2, numpy as np
+    A, R = _logpolar(a, win, PW); B, _ = _logpolar(b, win, PW); (dx, _), _ = cv2.phaseCorrelate(A, B)
+    return float(1.0 / np.exp(dx * np.log(R) / PW))
