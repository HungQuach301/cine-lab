+def _runs(fs, step):
+    """các quãng khung mẫu liền (cách ≤ 1,5 bước) → [(f0, f1)]"""
+    out = []
+    for f in sorted(fs):
+        if out and f - out[-1][1] <= 1.5 * step: out[-1][1] = f
+        else: out.append([f, f])
+    return [tuple(x) for x in out]
+
+
+def _run_s(f0, f1, step): return (f1 - f0 + step) / FPS
