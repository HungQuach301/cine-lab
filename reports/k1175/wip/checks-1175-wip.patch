+def soi_bmn(truoc, sau, nam, noi='', t4=False, out=None, tag='bmn', api=False, cache=None):
+    """(c) hai mô hình nhìn với lời nhắc BMN (cùng hạ tầng q_n2p_vision: GPT ghim + Claude ghim judge.MODEL; UA cố định; không email)"""
