+# ================================================================ (i-s) lớp sống — A3
+def kiem_song(G, P, Rc, Rk, Ab):
+    """→ (sai lớn nhất ngoài vùng bảo vệ, số điểm sai > 1). G ghép · P nền (chưa lớp sống) · Rc/Rk render có/không lớp sống · Ab vùng bảo vệ"""
