+            y2 = np.clip(yy + dy, 0, H - 1)
+            for dx in range(-S, S + 1):
+                v = float((DT[y2, np.clip(xx + dx, 0, W - 1)] <= p['R_DO'] * s).mean())
+                if dx == 0 and dy == 0: s0 = v
