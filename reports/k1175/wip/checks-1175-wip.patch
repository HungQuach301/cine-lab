+def _bien(M):
+    import numpy as np
+    b = np.zeros(M.shape, bool)
+    b[:-1] |= M[:-1] != M[1:]; b[1:] |= M[1:] != M[:-1]; b[:, :-1] |= M[:, :-1] != M[:, 1:]; b[:, 1:] |= M[:, 1:] != M[:, :-1]
+    return b
