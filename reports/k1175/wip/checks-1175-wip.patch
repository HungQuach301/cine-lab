+def quy_dao(Cs, Rs, IID, p=None):
+    """(d) Cs, Rs: danh sách khung BGR (cùng cỡ mặt nạ) → dict(e_h{id: e}, nhap_ghep, nhap_render). Độ sáng tuyến tính (sRGB → Y) TB mỗi nhà."""
