+# ================================================================ (i)(d) vòng bảo vệ khớp màu cục bộ — A4
+def kiem_vong(G, RK, A, Ab):
+    """→ (phần dư lớn nhất sau khi trừ độ lệch trung vị mỗi vòng, |độ lệch| lớn nhất, số vòng). Một vòng = (thành phần vùng bảo vệ) − (a)."""
