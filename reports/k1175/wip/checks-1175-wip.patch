+def _r(loi=(), thieu=(), val='', **kw):
+    loi, thieu = list(loi), list(thieu)
+    return dict(ok=not loi and not thieu, ket_qua='THIẾU' if thieu and not loi else None, loi=loi, thieu=thieu, val=val, **kw)
