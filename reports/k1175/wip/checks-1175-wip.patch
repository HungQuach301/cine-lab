+    lo_ = {}
+    for h, x in do.items(): lo_.setdefault(nha.get(h, {}).get('lo'), [0, 0]); lo_[nha.get(h, {}).get('lo')][0] += 1; lo_[nha.get(h, {}).get('lo')][1] += int(not x['loi'])
