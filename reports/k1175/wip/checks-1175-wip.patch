+        ring = (cc == i) & ~A
+        if ring.sum() < 2: continue
+        o = np.median(D[ring], 0); k += 1
+        res = max(res, float(np.abs(D[ring] - o).max())); off = max(off, float(np.abs(o).max()))
+    return res, off, k
