+// Cine Lab · ep01 STORY — shot của tập thử (đoạn 01, tấm nền 03, 04, 19). Nạp qua style.js → EXTRA (chỉ khi dbg.style có giá trị).
+// Cách làm: BỌC shot Last Round (film.js) — dựng nguyên bộ/rig, rồi
+//   (1) ánh xạ thời gian tin = map(t) (tuyến tính từng khúc, luôn tăng → mỗi khung một trạng thái, không khung trùng);
+//   (2) máy mới cỡ trung–xa, chuyển động chậm có easing (smootherstep), hoặc giữ máy gốc + trôi chậm;
+//   (3) sương mũ hai theo độ sâu, hạt bụi trong vùng sáng của ngọn đèn đang cháy, quầng rung (flickAt(f) của bộ phố, f = khung thật);
+//   (4) 'anon': người thắp đèn VÔ DANH dựng trên rig Ida — mũ chóp cao vành rộng + áo khoác dài vạt loe (dáng khác Ida);
+//   (5) sào mồi: thanh nối từ tay trái, đầu sào có than hồng, chạm sát đầu đèn trong khoảng 'pole';
+//   (6) tách bóng khỏi tường: viền sáng 2,75 px quanh toàn bộ bóng (style_v2 b3v3, tham số b3.rimAll — render.js bật mặc định).
+import * as THREE from '/cong3/shared/node_modules/three/build/three.module.js';
+import { SHOTS } from '/cong5/layout/film.js';
+import { buildStreetSet, LAMP_X, LAMP_Z } from '/cong5/layout/sets.js';
+import { fovOf } from '/cong5/layout/util.js';
+import { buildOffices } from './office.js';
+
+const ss = (u) => { u = Math.max(0, Math.min(1, u)); return u * u * u * (u * (u * 6 - 15) + 10); };
+const pw = (keys, t) => { if (t <= keys[0][0]) return keys[0][1]; for (let i = 0; i < keys.length - 1; i++) { const [a, x] = keys[i], [b, y] = keys[i + 1]; if (t <= b) return x + (y - x) * (t - a) / (b - a); } return keys[keys.length - 1][1]; };
+const V = (a) => new THREE.Vector3(...a);
+
+// src: shot Last Round; dur: giây; map: [[t, tin]...]; cam: { mm, p0, p1, l0, l1 } | null (máy gốc + trôi 'drift' m);
+// dust: chỉ số đèn có hạt bụi; anon: người vô danh; pole: [tin0, tin1] sào chạm; offices: dx; cas: [x, z, yaw] dời Cas.
+const CAM03 = { mm: 36, p0: [112.0, 1.2, 1.5], p1: [110.7, 1.4, 0.6], l0: [106.0, 2.5, -4.4], l1: [106.0, 2.75, -4.4] };
+const MAP03 = [[0, 0], [2.0, 0.55], [2.8, 0.7], [4.3, 1.3], [7.0, 1.95]];
+export const EP01_CFG = {
+  p03a: { src: 's03', dur: 7.0, map: MAP03, anon: 1, pole: [0.42, 0.78], dust: 4, cam: CAM03 },
+  p03b: { src: 's04', dur: 5.0, map: [[0, 0], [5.0, 1.5]], anon: 1, dust: 4,
+    cam: { mm: 28, p0: [99.0, 5.6, 3.5], p1: [100.1, 5.1, 3.0], l0: [106.5, 1.5, -4.6], l1: [106.3, 1.85, -4.6] } },
+  e01a: { src: 's01', dur: 6.0, map: [[0, 0], [6.0, 4.0]], cam: null, drift: 0 },
+  e01b: { src: 's02', dur: 5.0, map: [[0, 0], [5.0, 4.4]], cam: null, drift: 0.5 },
+  e01c: { src: 's03', dur: 7.0, map: MAP03, pole: [0.42, 0.78], dust: 4, cam: CAM03 },
+  e01d: { src: 's04', dur: 6.0, map: [[0, 0], [6.0, 1.5]], dust: 4,
+    cam: { mm: 28, p0: [99.0, 5.6, 3.5], p1: [100.2, 5.0, 3.0], l0: [106.5, 1.5, -4.6], l1: [106.3, 1.9, -4.6] } },
+  e01e: { src: 's05', dur: 7.0, map: [[0, 0], [7.0, 3.9]], dust: 4,
+    cam: { mm: 35, p0: [98.9, 2.3, -3.1], p1: [99.8, 2.45, -3.35], l0: [106.2, 2.65, -4.45], l1: [106.2, 2.8, -4.45] } },
+  e01f: { src: 's24', dur: 5.0, map: [[0, 0], [5.0, 1.95]], dust: 11,
+    cam: { mm: 32, p0: [13.6, 2.4, 4.2], p1: [12.6, 2.6, 3.6], l0: [8.0, 3.0, -4.6], l1: [8.0, 3.2, -4.6] } },
+  e01g: { src: 's43', dur: 5.333333, map: [[0, 0], [5.333333, 4.0]], cam: null, drift: 0 },
+  e04a: { src: 's22', dur: 5.0, map: [[0, 0], [5.0, 2.95]], s22: 1,
+    cam: { mm: 28, p0: [11.4, 1.4, -0.6], p1: [12.3, 1.5, -1.05], l0: [24.0, 3.2, -4.0], l1: [24.0, 3.35, -4.1] } },
+  e04b: { src: 's09w', dur: 3.0, map: [[0, 0], [3.0, 1.9]], cam: null, drift: 0.12 },
+  e04c: { src: 's09', dur: 4.5, map: [[0, 0], [4.5, 2.4]], cam: null, drift: 0.5 },
+  e04d: { src: 's19', dur: 3.25, map: [[0, 0], [3.25, 2.0]], cam: null, drift: 0.5 },
+  e19a: { src: 's23', dur: 7.5, map: [[0, 0], [7.5, 2.95]], offices: 0, dust: 10,
+    cam: { mm: 28, p0: [27.0, 1.5, 3.8], p1: [25.4, 1.75, 3.2], l0: [4.5, 2.0, -1.5], l1: [4.5, 2.5, -1.9] } },
+  e19b: { src: 's24', dur: 7.5, map: [[0, 0], [7.5, 1.95]], offices: 0, dust: 11, cas: [9.3, -5.3, -2.4],
+    cam: { mm: 30, p0: [14.2, 2.3, 4.4], p1: [13.0, 2.6, 3.7], l0: [8.0, 3.2, -4.6], l1: [8.0, 3.5, -4.6] } },
+};
+
+function anonymise(ch) {
+  const J = ch.joints, H = ch.H, mat = new THREE.MeshLambertMaterial({ color: '#2a2622', side: THREE.DoubleSide });
+  ch.root.traverse((o) => { if (o.isMesh && /hair|bun|braid|hat|scarf/i.test(o.userData.part || o.name || '')) o.visible = false; });
+  const brim = new THREE.Mesh(new THREE.CylinderGeometry(0.78 * H, 0.78 * H, 0.06 * H, 28), mat); brim.position.set(0, 0.92 * H, 0.02 * H);
+  const crown = new THREE.Mesh(new THREE.CylinderGeometry(0.42 * H, 0.47 * H, 0.95 * H, 24), mat); crown.position.set(0, 1.42 * H, 0.02 * H);
+  J.head.add(brim, crown);
+  const coat = new THREE.Mesh(new THREE.CylinderGeometry(0.62 * H, 1.05 * H, 3.0 * H, 24, 1, true), mat); coat.position.set(0, -1.15 * H, 0); J.spine.add(coat);
+  for (const m of [brim, crown, coat]) { m.castShadow = true; m.receiveShadow = true; m.userData.part = 'anon'; }
