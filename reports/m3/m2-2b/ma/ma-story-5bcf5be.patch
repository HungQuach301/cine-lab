+#!/bin/bash
+# Chạy render nền: [VID=<tệp.mkv>] [DBG=<json>] bg.sh <shot> <thư mục> <f0> <f1> [start]  → log ở /var/tmp/cine-out/ep01/story/log/<shot>_<f0>.log, in PID.
+cd "$(dirname "$0")/../../../.."
+mkdir -p /var/tmp/cine-out/ep01/story/log "$2"
+setsid nohup node design/m3/ep01/story/render.js --shot "$1" --dir "$2" --f0 "$3" --f1 "$4" --start "${5:-$3}" ${VID:+--vid "$VID"} ${DBG:+--dbg "$DBG"} > "/var/tmp/cine-out/ep01/story/log/$1_$3.log" 2>&1 < /dev/null &
+echo $!
+disown
