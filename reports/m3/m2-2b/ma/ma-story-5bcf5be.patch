+// Cine Lab · ep01 STORY — driver render chuỗi PNG theo shot (dựa trên design/m3/thu-phong-cach/frames.js, cùng page.js / style b3v3).
+// node design/m3/ep01/story/render.js --shot br10 --dir <thư mục PNG> [--f0 0 --f1 180] [--start 0] [--dbg '{"style":"b3v3"}'] [--w 1920 --h 1080]
+//   Khung f0..f1−1 (khung toàn cục của shot; shot ep01 có t0 = 0) → <dir>/%04d.png đánh số từ --start (mặc định 0).
+//   Ghi <dir>/timing.<f0>-<f1>.json: giây/khung (render + finalize), mean/max.
+const { chromium } = require('/opt/pw/node_modules/playwright');
+const { spawn } = require('child_process');
+const fs = require('fs'), path = require('path');
+const arg = (k, d) => { const i = process.argv.indexOf('--' + k); return i > 0 ? process.argv[i + 1] : d; };
+const ROOT = path.resolve(__dirname, '../../..');
+const W = +arg('w', 1920), H = +arg('h', 1080), SHOT = arg('shot'), DIR = path.resolve(arg('dir'));
+const dbg = JSON.parse(arg('dbg', '{"style":"b3v3","b3":{"rimAll":1}}'));   // rimAll: viền tách bóng 2,75 px (CHUAN-KENH-LL §5.3)
+const VID = arg('vid', null);   // --vid <tệp.mkv>: ghi thẳng H.264 crf 8 yuv444p (P 01/10: không FFV1, tiết kiệm đĩa) thay cho PNG
+
+(async () => {
+  fs.mkdirSync(DIR, { recursive: true });
+  const browser = await chromium.launch({ args: ['--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--ignore-gpu-blocklist', '--js-flags=--max-old-space-size=8192'] });
+  const page = await browser.newPage({ viewport: { width: 800, height: 600 } });
+  page.on('console', (m) => { const t = m.text(); if (!/GPU stall|GL Driver|THREE.WebGLRenderer/.test(t)) console.error('[page]', t); });
+  page.on('pageerror', (e) => console.error('[pageerror]', e.message));
+  await page.route('http://cine.local/**', (route) => {
+    const u = decodeURIComponent(new URL(route.request().url()).pathname), p = path.join(ROOT, u);
+    const type = p.endsWith('.js') ? 'text/javascript' : p.endsWith('.json') ? 'application/json' : p.endsWith('.png') ? 'image/png' : 'text/html';
+    if (!fs.existsSync(p)) return route.fulfill({ status: 404, body: 'not found ' + p });
+    route.fulfill({ status: 200, contentType: type, body: fs.readFileSync(p) });
+  });
+  await page.route('http://cine.local/tpc.html', (route) => route.fulfill({ status: 200, contentType: 'text/html',
+    body: '<!doctype html><html><body style="margin:0"><script type="module" src="/cong5/layout/page.js"></script></body></html>' }));
+  await page.goto('http://cine.local/tpc.html');
+  await page.waitForFunction(() => typeof window.setup === 'function', null, { timeout: 60000 });
+  const a = Date.now();
+  const r = await page.evaluate(async (cfg) => await window.setup(cfg), { W, H, shot: SHOT, nopaint: false, dbg });
+  const setup_s = (Date.now() - a) / 1000;
+  const F0 = Math.round(r.t0 * 24), F1 = Math.round(r.t1 * 24);
+  const f0 = +arg('f0', F0), f1 = +arg('f1', F1), start = +arg('start', f0 - F0);
+  const outA = VID ? ['-vf', 'vflip,format=yuv444p', '-c:v', 'libx264', '-preset', 'medium', '-crf', '8', '-g', '48', '-r', '24', VID]
+    : ['-vf', 'vflip', '-start_number', String(start), path.join(DIR, '%04d.png')];
+  const ff = spawn('ffmpeg', ['-hide_banner', '-loglevel', 'error', '-y', '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-s', `${W}x${H}`, '-framerate', '24', '-i', '-', ...outA], { stdio: ['pipe', 'inherit', 'inherit'] });
+  const times = [];
+  for (let f = f0; f < f1; f++) {
+    const b = Date.now();
+    await page.evaluate(async (f) => await window.renderFrame(f), f);
+    const b64 = await page.evaluate((f) => window.finalize(f), f);
+    times.push((Date.now() - b) / 1000);
+    const buf = Buffer.from(b64, 'base64');
+    if (!ff.stdin.write(buf)) await new Promise((res) => ff.stdin.once('drain', res));
+    if (times.length % 24 === 0) console.log(`[${SHOT}] ${f + 1 - f0}/${f1 - f0} mean ${(times.reduce((x, y) => x + y, 0) / times.length).toFixed(2)} s`);
+  }
+  ff.stdin.end(); await new Promise((res) => ff.on('close', res));
+  await browser.close();
+  const mean = times.reduce((x, y) => x + y, 0) / Math.max(1, times.length);
+  const rec = { shot: SHOT, dbg, W, H, f0, f1, start, frames: times.length, setup_s, per_frame_s: { mean: +mean.toFixed(3), max: +Math.max(...times).toFixed(3) }, times };
+  fs.writeFileSync(path.join(DIR, `timing.${f0}-${f1}.json`), JSON.stringify(rec, null, 1));
+  console.log(JSON.stringify({ shot: SHOT, frames: times.length, per_frame_s: rec.per_frame_s, setup_s }));
+})().catch((e) => { console.error(e); process.exit(1); });
