+  const x0 = align === 'right' ? x - w : align === 'center' ? x - w / 2 : x; g.fillStyle = fill; g.fillRect(x0, y - h / 2, w, h); if (dash) { g.setLineDash([8, 5]); g.strokeStyle = color; g.lineWidth = 2; g.strokeRect(x0 + 3, y - h / 2 + 3, w - 6, h - 6); g.setLineDash([]); }
