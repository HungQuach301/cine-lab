+"""Cine Lab · ep01 HISTORY — in mốc từng từ của lời dẫn, tính theo giây TƯƠNG ĐỐI đầu đoạn (t = vo_offset + mốc ký tự).
+python3 moc_tu.py NN [--json out.json]"""
+import json, sys
+R = '/home/user/cine-lab/reports/m3/m2-2b/'
+n = sys.argv[1]
+tl = [s for s in json.load(open(R + 'timeline-v3.json'))['doan'] if s['n'] == n][0]
+a = json.load(open(R + f'vo/bill-{n}.align.json'))
+ch, st, en = a['characters'], a['character_start_times_seconds'], a['character_end_times_seconds']
+words, cur = [], None
+for c, s, e in zip(ch, st, en):
+    if c.isspace():
+        if cur: words.append(cur); cur = None
+        continue
+    if cur is None: cur = [c, s, e]
+    else: cur[0] += c; cur[2] = e
+if cur: words.append(cur)
+off = tl['vo_offset']
+out = [[w, round(s + off, 3), round(e + off, 3)] for w, s, e in words]
+if '--json' in sys.argv:
+    json.dump({'n': n, 'dur': tl['dur'], 'khung': tl['khung'], 'words': out}, open(sys.argv[sys.argv.index('--json') + 1], 'w'), ensure_ascii=False)
+else:
+    print(n, 'dur', round(tl['dur'], 3), 'khung', tl['khung'])
+    print(' '.join(f'{w}@{s:.2f}' for w, s, e in out))
