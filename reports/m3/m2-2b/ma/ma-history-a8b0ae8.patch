+"""Cine Lab · ep01 HISTORY — tổng hợp số đo cuối gói: số khung, mã hoá, judder, giây/khung, dung lượng."""
+import json, os, subprocess
+S = '/var/tmp/cine-out/ep01/sec/'
+tl = {s['n']: s for s in json.load(open('/home/user/cine-lab/reports/m3/m2-2b/timeline-v3.json'))['doan']}
+allt = []
+for n in ['02', '03', '05', '06', '07', '08', '09']:
+    k = tl[n]['khung']; need = k[1] - k[0]
+    nf = subprocess.run(['ffprobe', '-v', 'error', '-count_frames', '-select_streams', 'v:0', '-show_entries', 'stream=codec_name,pix_fmt,width,height,r_frame_rate,nb_read_frames', '-of', 'csv=p=0', S + n + '.mkv'], capture_output=True, text=True).stdout.strip()
+    j = json.load(open(S + n + '.judder.json')); tm = json.load(open(S + n + '.timing.json')); allt += tm['times']
+    print(n, 'cần', need, '|', nf, '| judder loi', j['loi'], 'giu>=1s', j['giu_co_y_ge_1s'], 'giu13-23', j['giu_ngan_13_23'], '| s/khung', tm['per_frame_s'], 'wall', tm.get('wall_s'), '| MB', os.path.getsize(S + n + '.mkv') // 1048576)
+print('tổng khung', len(allt), 'TB', round(sum(allt) / len(allt), 3), 'max', round(max(allt), 3))
