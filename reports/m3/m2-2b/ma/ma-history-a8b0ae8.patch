+
+// ---------- chữ ----------
+function text(g, s, x, y, f, color, align = 'left', base = 'alphabetic') { g.font = f; g.fillStyle = color; g.textAlign = align; g.textBaseline = base; g.fillText(s, x, y); }
+function textA(g, s, x, y, f, color, a, align = 'left', base = 'alphabetic') { if (a <= 0) return; g.save(); g.globalAlpha *= cl(a); text(g, s, x, y, f, color, align, base); g.restore(); }
+// chữ hiện bằng "mực thấm" từ trái sang phải (clip), a = tiến độ 0..1
+function textWipe(g, s, x, y, f, color, a, align = 'left', base = 'alphabetic') { if (a <= 0) return; g.save(); g.font = f; const w = g.measureText(s).width;
+  const x0 = align === 'center' ? x - w / 2 : align === 'right' ? x - w : x; g.beginPath(); g.rect(x0 - 4, y - 400, (w + 30) * sm(a), 800); g.clip();
