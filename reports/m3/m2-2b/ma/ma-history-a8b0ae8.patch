+#!/bin/bash
+# Cine Lab · ep01 HISTORY — render một đoạn (một khối) bằng 2 tiến trình song song → trung gian H.264 crf 10 yuv444p (concat copy) → judder → xoá tệp tạm.
+# Luật đĩa CHUAN-KENH-LL §6 (P chuyển 01/10/2026): ghi mức cần ước + df trước khối, mức đĩa đỉnh theo khối vào TIEN-DO.md; dừng khi trống < 6 GB.
+# bash do_khoi.sh NN [thư mục tấm nền]   → /var/tmp/cine-out/ep01/sec/NN.mkv + NN.timing.json + NN.judder.json
+set -e
+D=$(cd "$(dirname "$0")" && pwd); NN=$1; PLATE=$2
+TD=/var/tmp/cine-out/ep01/history/TIEN-DO.md
+O=/var/tmp/cine-out/ep01/sec; T=/var/tmp/cine-out/ep01/history/tmp_$NN; K=/var/tmp/cine-out/ep01/history/khung; mkdir -p $O $T $K
+N=$(python3 -c "import json;s=[x for x in json.load(open('/home/user/cine-lab/reports/m3/m2-2b/timeline-v3.json'))['doan'] if x['n']=='$NN'][0];print(s['khung'][1]-s['khung'][0])")
+AV=$(df --output=avail -k / | tail -1); CAN=$(( N * 160 / 1440 + 1 ))
+echo "- khối $NN ($(date +%H:%M)): cần ước ≈ ${CAN} MB (160 MB/phút × $N khung), cộng ≈ ${CAN} MB tạm khi ghép; df trống $(( AV / 1024 )) MB" >> $TD
+if [ $AV -lt 6000000 ]; then echo "  DỪNG: đĩa trống < 6 GB, chờ P" >> $TD; echo "đĩa trống < 6 GB ($AV kB), dừng"; exit 2; fi
+H=$(( N / 2 )); PNG=${PNGS:-}
+S=$(date +%s)
+PA=(); [ -n "$PLATE" ] && PA=(--plate "$PLATE")
+( mn=$AV; while sleep 5; do a=$(df --output=avail -k / | tail -1); [ $a -lt $mn ] && mn=$a; echo $mn > $T/min_avail; done ) & SAMP=$!
+node $D/render.js --sec $NN --out $T/a.mkv --from 0 --to $H "${PA[@]}" --png "$PNG" --pngdir $K > $T/log_a.txt 2>&1 &
+P1=$!
+node $D/render.js --sec $NN --out $T/b.mkv --from $H --to $N "${PA[@]}" --png "$PNG" --pngdir $K > $T/log_b.txt 2>&1 &
+P2=$!
+wait $P1 $P2 || true
+if grep -q "No space left" $T/log_*.txt; then echo "  LỖI khối $NN: No space left on device — dừng ghi, báo P" >> $TD; kill $SAMP; exit 3; fi
+printf "file '%s'\nfile '%s'\n" $T/a.mkv $T/b.mkv > $T/list.txt
+ffmpeg -v error -y -f concat -safe 0 -i $T/list.txt -c copy $O/$NN.mkv
+kill $SAMP 2>/dev/null || true
+python3 - <<EOF
+import json
+a=json.load(open('$T/a.mkv.timing.json')); b=json.load(open('$T/b.mkv.timing.json')); ts=a['times']+b['times']
+json.dump({'sec':'$NN','frames':len(ts),'wall_s':$(( $(date +%s) - S )),'per_frame_s':{'mean':round(sum(ts)/len(ts),3),'max':round(max(ts),3)},'times':ts},open('$O/$NN.timing.json','w'))
+print('timing', len(ts), round(sum(ts)/len(ts),3), round(max(ts),3))
+EOF
+rm -f $T/a.mkv $T/b.mkv $K/s${NN}_f*.png   # xoá trung gian tạm + PNG khung của khối
+MN=$(cat $T/min_avail 2>/dev/null || echo $AV)
+NF=$(ffprobe -v error -count_frames -select_streams v:0 -show_entries stream=nb_read_frames -of csv=p=0 $O/$NN.mkv)
+echo "frames_mkv $NF / $N"
+python3 /home/user/cine-lab/scripts/p/judder.py $O/$NN.mkv --json $O/$NN.judder.json > /dev/null || true
+J=$(python3 -c "import json;d=json.load(open('$O/$NN.judder.json'));print(d['loi'],d['giu_co_y_ge_1s'])")
+echo "  khối $NN xong ($(date +%H:%M)): $NF/$N khung, judder (loi, giu≥1s) = $J; tệp $(( $(stat -c %s $O/$NN.mkv) / 1048576 )) MB; đĩa trống thấp nhất trong khối $(( MN / 1024 )) MB" >> $TD
+echo "judder $J"
