+#!/bin/bash
+# Cine Lab · ep01 HISTORY — render một đoạn bằng 2 tiến trình song song, ghép H.264 crf 10 (concat copy), gộp timing, chạy judder.
+# bash do_sec.sh NN [thư mục tấm nền]   → /var/tmp/cine-out/ep01/sec/NN.mkv + NN.timing.json + NN.judder.json
+set -e
+AV=$(df --output=avail -k /var/tmp | tail -1); df -h / | tail -1; [ $AV -lt 3000000 ] && { echo "đĩa còn < 3 GB ($AV kB), dừng"; exit 2; }
+D=$(cd "$(dirname "$0")" && pwd); NN=$1; PLATE=$2
+O=/var/tmp/cine-out/ep01/sec; T=/var/tmp/cine-out/ep01/history/tmp_$NN; mkdir -p $O $T /var/tmp/cine-out/ep01/history/khung
+N=$(python3 -c "import json;s=[x for x in json.load(open('/home/user/cine-lab/reports/m3/m2-2b/timeline-v3.json'))['doan'] if x['n']=='$NN'][0];print(s['khung'][1]-s['khung'][0])")
+H=$(( N / 2 )); PNG=${PNGS:-}
+S=$(date +%s)
+PA=(); [ -n "$PLATE" ] && PA=(--plate "$PLATE")
+node $D/render.js --sec $NN --out $T/a.mkv --from 0 --to $H "${PA[@]}" --png "$PNG" --pngdir /var/tmp/cine-out/ep01/history/khung > $T/log_a.txt 2>&1 &
+node $D/render.js --sec $NN --out $T/b.mkv --from $H --to $N "${PA[@]}" --png "$PNG" --pngdir /var/tmp/cine-out/ep01/history/khung > $T/log_b.txt 2>&1 &
+wait
+printf "file '%s'\nfile '%s'\n" $T/a.mkv $T/b.mkv > $T/list.txt
+ffmpeg -v error -y -f concat -safe 0 -i $T/list.txt -c copy $O/$NN.mkv
+python3 - <<EOF
+import json
+a=json.load(open('$T/a.mkv.timing.json')); b=json.load(open('$T/b.mkv.timing.json')); ts=a['times']+b['times']
+json.dump({'sec':'$NN','frames':len(ts),'wall_s':$(( $(date +%s) - S )),'per_frame_s':{'mean':round(sum(ts)/len(ts),3),'max':round(max(ts),3)},'times':ts},open('$O/$NN.timing.json','w'))
+print('timing', len(ts), round(sum(ts)/len(ts),3), round(max(ts),3))
+EOF
+rm -f $T/a.mkv $T/b.mkv   # tiết kiệm đĩa dùng chung
+echo "frames_mkv $(ffprobe -v error -count_frames -select_streams v:0 -show_entries stream=nb_read_frames -of csv=p=0 $O/$NN.mkv) / $N"
+python3 /home/user/cine-lab/scripts/p/judder.py $O/$NN.mkv --json $O/$NN.judder.json | tail -5 || true
