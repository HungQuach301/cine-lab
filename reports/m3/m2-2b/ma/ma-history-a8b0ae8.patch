+"""Cine Lab · ep01 HISTORY — rút khung từ clip đoạn và ghép bảng xem (½ cỡ, 2 cột).
+/opt/cine/bin/python khung.py NN 2.5,14.2,... out.jpg [--full]"""
+import io, subprocess, sys
+from PIL import Image
+NN, ts, out = sys.argv[1], [float(x) for x in sys.argv[2].split(',')], sys.argv[3]
+full = '--full' in sys.argv
+ims = []
+for t in ts:
+    r = subprocess.run(['ffmpeg', '-nostdin', '-v', 'error', '-ss', f'{t}', '-i', f'/var/tmp/cine-out/ep01/sec/{NN}.mkv', '-frames:v', '1', '-f', 'image2pipe', '-vcodec', 'png', '-'], capture_output=True, check=True)
+    im = Image.open(io.BytesIO(r.stdout)).convert('RGB'); ims.append(im if full else im.resize((960, 540)))
+w, h = ims[0].size; cols = 1 if full else 2
+g = Image.new('RGB', (w * cols, h * ((len(ims) + cols - 1) // cols)))
+for i, im in enumerate(ims): g.paste(im, ((i % cols) * w, (i // cols) * h))
+g.save(out, quality=82)
