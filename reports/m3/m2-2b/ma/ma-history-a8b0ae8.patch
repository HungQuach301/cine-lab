+TL = {s['n']: s for s in json.load(open('/home/user/cine-lab/reports/m3/m2-2b/timeline-v3.json'))['doan']}
+D = '/var/tmp/cine-out/m22a/sfx/'
+FLIP, HISS, SLIDE = (D + '320149.mp3', 3.55, 0.85, 'M2-SFX-1'), (D + '159386.mp3', 2.0, None, 'M2-SFX-2'), (D + '470189.mp3', 0.0, 0.37, 'M2-SFX-3')
+CUES = {   # (tệp, giây cục bộ, gain dB, độ dài nếu đổi, ghi chú)
+ '02': [(HISS, 0.35, -19.0, 3.4, 'đèn khí xì nhẹ khi đèn thẻ tựa bật (mờ ra trước lời)'), (FLIP, 3.35, -12.0, None, 'thẻ tựa → bản đồ')],
