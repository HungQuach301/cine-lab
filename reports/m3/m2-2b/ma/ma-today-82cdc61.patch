+Chữ tối/nền sáng: chữ = trung vị 3 % điểm tối nhất, nền = trung vị 40 % điểm sáng nhất; chữ sáng: ngược lại. Ô theo toạ độ khung 1920×1080; giây tính trong đoạn.
+/opt/cine/bin/python tp.py <NN> [<thư mục clip>]  → in từng ô + JSON {min_thong_tin, min_ten}
+"""
+import io, json, subprocess, sys
+import numpy as np
+from PIL import Image
+def lin(c): c = c / 255.0; return np.where(c <= 0.03928, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)
+def L(rgb): r, g, b = lin(np.array(rgb, float)); return 0.2126 * r + 0.7152 * g + 0.0722 * b
+def ratio(a, b): la, lb = L(a), L(b); return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)
+BOX = {
+ '14': [(31.0, 'nguồn BLS', (208, 952, 880, 978), 'dark'), (31.0, '"1960 classification"', (718, 903, 902, 926), 'dark'), (31.0, '"94k → 77k"', (495, 879, 605, 902), 'dark'),
+        (31.0, 'thẻ PROJECTION (navy)', (1215, 203, 1525, 239), 'light'), (31.0, '"forecast" (nâu)', (1048, 222, 1170, 248), 'dark'), (31.0, 'giá trị "−28%"', (1440, 590, 1540, 622), 'dark'),
+        (58.5, '"insurance offices"', (1270, 916, 1470, 940), 'dark'), (58.5, '"writing"', (1000, 304, 1110, 330), 'dark'), (58.5, 'thẻ "AI" (navy)', (925, 785, 980, 821), 'light')],
+ '15': [(20.0, 'dòng ghi nguồn trên thẻ', (1185, 660, 1660, 690), 'dark'), (20.0, 'chữ trích "powered by AI"', (1180, 540, 1580, 600), 'dark'),
+        (20.0, 'dòng nguồn', (208, 940, 1135, 966), 'dark'), (20.0, 'nhãn trục "+4%"', (365, 368, 422, 392), 'dark'), (20.0, 'thẻ PROJECTION (navy)', (212, 224, 640, 258), 'light')],
+ '16': [(46.0, '"all occupations"', (880, 505, 1040, 530), 'dark'), (46.0, '"Credit analysts"', (1010, 885, 1200, 910), 'dark'),
+        (46.0, 'dòng nguồn', (208, 958, 1100, 982), 'dark'), (46.0, 'thẻ PROJECTION 2023–33 (nâu)', (1310, 143, 1700, 177), 'light'), (7.5, 'chú thích Bessen', (610, 908, 1310, 934), 'dark')],
+ '17': [(33.0, '"employment index…"', (570, 780, 920, 804), 'dark'), (33.0, '"mostly fewer hires"', (1375, 702, 1575, 726), 'dark'),
+        (33.0, 'dấu "early signal…" (nâu)', (1100, 862, 1680, 898), 'dark'), (33.0, '"U.S. payroll data…"', (382, 204, 830, 230), 'dark'), (33.0, 'dòng nguồn', (208, 940, 1100, 966), 'dark')],
+ '18': [(21.5, 'thẻ "change"', (905, 785, 1015, 825), 'dark'), (21.5, 'dòng ghi nguồn', (208, 955, 860, 978), 'dark')],
+ '10-13': [(11.5, 'G1 "1950 classification"', (610, 272, 790, 292), 'dark'), (11.5, 'G1 "1960 classification"', (626, 396, 820, 422), 'dark'), (11.5, 'G1 "1970 classification"', (968, 558, 1164, 584), 'dark'),
+           (11.5, 'G1 chú thích phân loại', (408, 856, 1260, 880), 'dark'), (11.5, 'G1 nhãn ACTUAL', (1250, 136, 1700, 170), 'dark'),
+           (16.0, 'bìa BLS (chữ sáng trên navy)', (835, 418, 1300, 452), 'light'), (16.0, 'bìa BLS "Employment Projections"', (836, 520, 1330, 556), 'dark'), (23.0, 'dải "2035"', (1480, 280, 1550, 306), 'dark'),
+           (35.0, 'G3 nhãn PROJECTION (navy)', (1330, 138, 1706, 167), 'light'), (35.0, 'G3 số lớn "−34%"', (698, 248, 1010, 348), 'dark'), (35.0, 'G3 nhãn hàng 1', (330, 406, 622, 436), 'dark'),
+           (57.6, 'G4 câu trích lớn', (790, 440, 1600, 475), 'dark'), (60.0, 'G4 nhãn kỳ 2023–33 (nâu)', (762, 122, 1100, 151), 'light'), (60.0, 'G4 tiêu đề', (748, 180, 1300, 232), 'dark'),
+           (87.0, 'G5 nhãn nhóm 2025–35 (nâu)', (220, 684, 525, 709), 'light'), (87.0, 'G5 dòng nguồn 2', (208, 954, 760, 978), 'dark'), (92.5, 'G6 thẻ "change"', (1095, 305, 1240, 348), 'dark')],
