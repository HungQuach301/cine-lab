--- /dev/null
+++ b/design/m3/ep01/today/chot.sh
@@ -0,0 +1,13 @@
+#!/bin/bash
+# Chốt một đoạn: FFV1 tạm (/dev/shm, vì đĩa đầy 12:38) → H.264 crf 10 yuv444p -g 48 (hợp đồng P đổi 01/10/2026) ở /var/tmp/cine-out/ep01/sec/<NN>.mkv,
+# kiểm số khung, chạy judder.py, xoá FFV1. Dùng: bash chot.sh 14
+set -e
+N=$1; S=/dev/shm/ep01-today/sec; O=/var/tmp/cine-out/ep01/sec
+df -h / | tail -1
+if [ "$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 $S/$N.mkv)" = h264 ]; then cp $S/$N.mkv $O/$N.mkv; else ffmpeg -nostdin -v error -y -i $S/$N.mkv -c:v libx264 -preset medium -crf 10 -pix_fmt yuv444p -g 48 -r 24 $O/$N.mkv; fi
+cp $S/$N.mkv.timing.json $O/$N.timing.json
+echo "khung: $(ffprobe -v error -count_frames -select_streams v:0 -show_entries stream=nb_read_frames -of csv=p=0 $O/$N.mkv)"
+python3 /home/user/cine-lab/scripts/p/judder.py $O/$N.mkv --json /var/tmp/cine-out/ep01/today/judder-$N.json > /dev/null 2>&1 || true
+python3 -c "import json;d=json.load(open('/var/tmp/cine-out/ep01/today/judder-$N.json'));print({k:d.get(k) for k in ('so_khung','loi','giu_co_y_ge_1s','giu_ngan_13_23')})"
+rm -f $S/$N.mkv
+stat -c '%s byte' $O/$N.mkv
