+n = sys.argv[1]; d = sys.argv[2] if len(sys.argv) > 2 else '/var/tmp/cine-out/ep01/sec'; v = f'{d}/{n}.mkv'
+res = []
+for t, name, b, kind in BOX[n]:
+    r = subprocess.run(['ffmpeg', '-nostdin', '-v', 'error', '-ss', f'{t}', '-i', v, '-frames:v', '1', '-f', 'image2pipe', '-vcodec', 'png', '-'], capture_output=True, check=True)
+    im = Image.open(io.BytesIO(r.stdout)).convert('RGB')
+    a = np.asarray(im.crop(b)).reshape(-1, 3).astype(int); o = np.argsort(a.sum(1)); k = len(o)
+    lo, hi = a[o[: max(1, k * 3 // 100)]], a[o[-k * 40 // 100:]]
+    if kind == 'light': lo, hi = a[o[: k * 40 // 100]], a[o[-max(1, k * 3 // 100):]]
+    fg = np.median(lo if kind == 'dark' else hi, axis=0); bg = np.median(hi if kind == 'dark' else lo, axis=0)
+    q = ratio(fg, bg); res.append(dict(t=t, name=name, ratio=round(float(q), 2))); print(f'{t:6.1f}s  {q:5.2f}:1  {name}')
+print(json.dumps({'doan': n, 'min_thong_tin': min(x['ratio'] for x in res), 'min_ten': min(res, key=lambda x: x['ratio'])['name']}, ensure_ascii=False))
