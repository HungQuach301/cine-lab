+gd = np.sqrt(((xx - W / 2) / 700) ** 2 + ((yy - (H + 120)) / 420) ** 2)
+glow = np.exp(-gd ** 2 * 2.2)[..., None]
+
+# lớp chữ, vẽ một lần ở 2× rồi biến hình mỗi khung
+S = 2
+def text_layer():
+    im = Image.new('L', (W * S, H * S), 0); d = ImageDraw.Draw(im)
+    ft = ImageFont.truetype(FT.path, FT.size * S); fs = ImageFont.truetype(FS.path, FS.size * S)
+    b1, b2, bs = d.textbbox((0, 0), L1, font=ft), d.textbbox((0, 0), L2, font=ft), d.textbbox((0, 0), SUB, font=fs)
+    lh = int(FT.size * S * 1.15)
+    y1 = H * S // 2 - lh - 30 * S
+    d.text(((W * S - (b1[2] - b1[0])) // 2 - b1[0], y1), L1, font=ft, fill=255)
+    d.text(((W * S - (b2[2] - b2[0])) // 2 - b2[0], y1 + lh), L2, font=ft, fill=255)
+    sub = Image.new('L', (W * S, H * S), 0); ds = ImageDraw.Draw(sub)
+    ys = y1 + 2 * lh + 70 * S
+    ds.text(((W * S - (bs[2] - bs[0])) // 2 - bs[0], ys), SUB, font=fs, fill=255)
+    meas = {'dong1_px': (b1[2] - b1[0]) / S, 'dong2_px': (b2[2] - b2[0]) / S, 'dong_nho_px': (bs[2] - bs[0]) / S,
+            'ty_le_dong_dai_nhat': round((b1[2] - b1[0]) / S / W, 3), 'y_tren': y1 / S, 'y_duoi': (ys + bs[3]) / S}
