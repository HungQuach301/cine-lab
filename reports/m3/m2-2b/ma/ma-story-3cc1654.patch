index 0000000..f34ecc9
--- /dev/null
+++ b/design/m3/ep01/story/kiem_png.py
@@ -0,0 +1,19 @@
+"""Kiểm thư mục PNG tấm nền: số khung, cỡ, giải mã được, khung kề trùng (md5 điểm ảnh), giây/khung từ timing.*.json.
+python3 kiem_png.py <thư mục> <số khung mong đợi>"""
+import hashlib, json, os, sys, glob
+from PIL import Image
+d, n = sys.argv[1], int(sys.argv[2])
+fs = [os.path.join(d, '%04d.png' % i) for i in range(n)]
+miss = [f for f in fs if not os.path.exists(f)]
+hs, bad = [], []
+for f in fs:
+    if f in miss: hs.append(None); continue
+    im = Image.open(f); im.load()
+    if im.size != (1920, 1080): bad.append(f)
+    hs.append(hashlib.md5(im.tobytes()).hexdigest())
+dup = [i for i in range(n - 1) if hs[i] and hs[i] == hs[i + 1]]
+ts = []
+for j in glob.glob(os.path.join(d, 'timing.*.json')):
+    ts += json.load(open(j))['times'][1:]   # bỏ khung đầu mỗi tiến trình (nạp shader)
+print(json.dumps({'dir': d, 'expect': n, 'missing': len(miss), 'badsize': len(bad), 'dup_adjacent': dup,
+                  'sec_per_frame': {'mean': round(sum(ts) / max(1, len(ts)), 2), 'max': round(max(ts or [0]), 2)}}))
