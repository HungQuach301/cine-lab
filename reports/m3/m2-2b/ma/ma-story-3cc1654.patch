index 0000000..813b80a
--- /dev/null
+++ b/design/m3/ep01/story/office.js
@@ -0,0 +1,67 @@
+// Cine Lab · ep01 STORY — khối văn phòng hậu cảnh v2 (chủ dự án yêu cầu, 01/10/2026), dùng cho br10 (khối 10–13) và đoạn 19.
+// Thay "một tấm lưới đều 64 × 40 m" của lát cắt bằng BA khối ở ba độ sâu, thấp hơn, xa hơn, không phủ kín trời:
+//   A gần (x −38, z −10, cao 19 m), B giữa (x −78, z +11, cao 28 m), C xa (x −132, z −1, cao 56 m) — lệch ngang để khối xa lộ giữa hai khối gần.
+// Cửa sổ (tất định theo hạt giống, hàm liên tục của t):
+//   - mật độ sáng khác nhau theo tầng (mỗi tầng một xác suất 0,08–0,9; vài tầng gần như tắt), cụm cột ít đèn (phòng trống);
+//   - ≈ 7 % ô ấm (đèn bàn), còn lại trắng lạnh với độ sáng lệch ±18 %;
+//   - ≈ 4,5 % ô "sống": bật/tắt chậm bằng smoothstep của sin chu kỳ 5–11 s (không nhảy bậc).
+// Sương theo độ sâu do THREE.Fog của shot (khối càng xa càng chìm); mặt bên tối + gờ mái giữ khối.
+import * as THREE from '/cong3/shared/node_modules/three/build/three.module.js';
+
+export const BLOCKS = [
+  { id: 'A', x: -38, z: -10, w: 16, h: 19, d: 14, cols: 9, rows: 6, seed: 11 },
+  { id: 'B', x: -78, z: 11, w: 18, h: 28, d: 16, cols: 10, rows: 9, seed: 23 },
+  { id: 'C', x: -132, z: -1, w: 28, h: 56, d: 18, cols: 15, rows: 13, seed: 37 },
+];
+const sm = (a, b, x) => { const u = Math.max(0, Math.min(1, (x - a) / (b - a))); return u * u * (3 - 2 * u); };
+
+function makeBlock(B) {
+  let s = B.seed * 7919; const R = () => (s = (s * 16807) % 2147483647) / 2147483647;
+  const TW = 512, TH = Math.round(512 * B.h / B.w);
+  const cv = document.createElement('canvas'); cv.width = TW; cv.height = TH; const g = cv.getContext('2d');
+  const floorP = Array.from({ length: B.rows }, () => { const r = R(); return r < 0.18 ? 0.08 : r < 0.45 ? 0.35 : 0.55 + 0.35 * R(); });
+  const colDark = Array.from({ length: B.cols }, () => (R() < 0.22 ? 0.55 + 0.4 * R() : 1));
+  const wins = [];
+  for (let r = 0; r < B.rows; r++) for (let c = 0; c < B.cols; c++) {
+    const p = floorP[r] * colDark[c], on = R() < p, warm = R() < 0.07, k = 0.82 + 0.36 * R();
+    const live = R() < 0.045, per = 5 + 6 * R(), ph = 6.283 * R();
+    wins.push({ r, c, on, warm, k, live, per, ph });
+  }
+  const tex = new THREE.CanvasTexture(cv); tex.colorSpace = THREE.SRGBColorSpace;
+  const cw = TW / B.cols, rh = TH / B.rows;
+  function draw(t) {
+    g.fillStyle = '#20222b'; g.fillRect(0, 0, TW, TH);
+    for (const w of wins) {
+      let a = w.on ? 1 : 0;
+      if (w.live) a = sm(-0.35, 0.35, Math.sin(6.283 * t / w.per + w.ph));
+      const off = [52, 56, 68], lit = w.warm ? [255, 214, 150] : [226, 236, 255];
+      const col = lit.map((v, i) => Math.min(255, Math.round(off[i] + (v * w.k - off[i]) * a)));
+      g.fillStyle = `rgb(${col[0]},${col[1]},${col[2]})`;
+      g.fillRect(w.c * cw + cw * 0.17, w.r * rh + rh * 0.22, cw * 0.66, rh * 0.56);
+    }
+    for (let r = 0; r <= B.rows; r++) { g.fillStyle = '#16181f'; g.fillRect(0, r * rh - 2, TW, 4); }
+    tex.needsUpdate = true;
+  }
+  draw(0);
+  const grp = new THREE.Group();
+  const face = new THREE.Mesh(new THREE.PlaneGeometry(B.w, B.h), new THREE.MeshBasicMaterial({ map: tex, color: new THREE.Color('#ffffff').multiplyScalar(1.1), fog: true }));
+  face.position.set(B.x, B.h / 2, B.z); face.rotation.y = Math.PI / 2; grp.add(face);
+  const body = new THREE.Mesh(new THREE.BoxGeometry(B.d, B.h, B.w), new THREE.MeshLambertMaterial({ color: '#1c1e27' }));
+  body.position.set(B.x - B.d / 2 - 0.01, B.h / 2, B.z); grp.add(body);
+  const cap = new THREE.Mesh(new THREE.BoxGeometry(B.d + 0.6, 0.8, B.w + 0.6), new THREE.MeshLambertMaterial({ color: '#15171d' }));
+  cap.position.set(B.x - B.d / 2, B.h + 0.4, B.z); grp.add(cap);
+  const plinth = new THREE.Mesh(new THREE.BoxGeometry(B.d + 1, 24, B.w + 1), new THREE.MeshLambertMaterial({ color: '#14161c' }));   // chân khối: khối đứng trên đất, không lơ lửng
+  plinth.position.set(B.x - B.d / 2, -12, B.z); grp.add(plinth);
+  return { grp, draw, B, wins };
+}
+
+// Trả { blocks, update(t), stats() }. Gọi update(t) mỗi khung.
+export function buildOffices(scene, opts = {}) {
+  const blocks = (opts.blocks || BLOCKS).map((b) => makeBlock({ ...b, x: b.x + (opts.dx || 0) }));
+  for (const b of blocks) scene.add(b.grp);
+  const ground = new THREE.Mesh(new THREE.PlaneGeometry(420, 300).rotateX(-Math.PI / 2), new THREE.MeshLambertMaterial({ color: '#15171f' }));   // nền tối sau cuối phố (hết dải trời dưới chân khối)
+  ground.position.set(-200 + (opts.dx || 0), -2.5, 0); scene.add(ground);
+  const spill = new THREE.PointLight('#e3eaff', 22, 40, 1.4); spill.position.set(-32 + (opts.dx || 0), 10, -8); scene.add(spill);
+  return { blocks, update(t) { for (const b of blocks) b.draw(t); },
+    stats() { return blocks.map((b) => ({ id: b.B.id, n: b.wins.length, on: b.wins.filter((w) => w.on).length, warm: b.wins.filter((w) => w.warm && w.on).length, live: b.wins.filter((w) => w.live).length })); } };
+}
diff --git a/design/m3/ep01/story/render.js b/design/m3/ep01/story/render.js
new file mode 100644
index 0000000..df3c4e8
--- /dev/null
+++ b/design/m3/ep01/story/render.js
@@ -0,0 +1,54 @@
+// Cine Lab · ep01 STORY — driver render chuỗi PNG theo shot (dựa trên design/m3/thu-phong-cach/frames.js, cùng page.js / style b3v3).
+// node design/m3/ep01/story/render.js --shot br10 --dir <thư mục PNG> [--f0 0 --f1 180] [--start 0] [--dbg '{"style":"b3v3"}'] [--w 1920 --h 1080]
+//   Khung f0..f1−1 (khung toàn cục của shot; shot ep01 có t0 = 0) → <dir>/%04d.png đánh số từ --start (mặc định 0).
+//   Ghi <dir>/timing.<f0>-<f1>.json: giây/khung (render + finalize), mean/max.
+const { chromium } = require('/opt/pw/node_modules/playwright');
+const { spawn } = require('child_process');
+const fs = require('fs'), path = require('path');
+const arg = (k, d) => { const i = process.argv.indexOf('--' + k); return i > 0 ? process.argv[i + 1] : d; };
+const ROOT = path.resolve(__dirname, '../../..');
+const W = +arg('w', 1920), H = +arg('h', 1080), SHOT = arg('shot'), DIR = path.resolve(arg('dir'));
+const dbg = JSON.parse(arg('dbg', '{"style":"b3v3","b3":{"rimAll":1}}'));   // rimAll: viền tách bóng 2,75 px (CHUAN-KENH-LL §5.3)
+const VID = arg('vid', null);   // --vid <tệp.mkv>: ghi thẳng H.264 crf 8 yuv444p (P 01/10: không FFV1, tiết kiệm đĩa) thay cho PNG
+
+(async () => {
+  fs.mkdirSync(DIR, { recursive: true });
+  const browser = await chromium.launch({ args: ['--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--ignore-gpu-blocklist', '--js-flags=--max-old-space-size=8192'] });
+  const page = await browser.newPage({ viewport: { width: 800, height: 600 } });
+  page.on('console', (m) => { const t = m.text(); if (!/GPU stall|GL Driver|THREE.WebGLRenderer/.test(t)) console.error('[page]', t); });
+  page.on('pageerror', (e) => console.error('[pageerror]', e.message));
+  await page.route('http://cine.local/**', (route) => {
+    const u = decodeURIComponent(new URL(route.request().url()).pathname), p = path.join(ROOT, u);
+    const type = p.endsWith('.js') ? 'text/javascript' : p.endsWith('.json') ? 'application/json' : p.endsWith('.png') ? 'image/png' : 'text/html';
+    if (!fs.existsSync(p)) return route.fulfill({ status: 404, body: 'not found ' + p });
+    route.fulfill({ status: 200, contentType: type, body: fs.readFileSync(p) });
+  });
+  await page.route('http://cine.local/tpc.html', (route) => route.fulfill({ status: 200, contentType: 'text/html',
+    body: '<!doctype html><html><body style="margin:0"><script type="module" src="/cong5/layout/page.js"></script></body></html>' }));
+  await page.goto('http://cine.local/tpc.html');
+  await page.waitForFunction(() => typeof window.setup === 'function', null, { timeout: 60000 });
+  const a = Date.now();
+  const r = await page.evaluate(async (cfg) => await window.setup(cfg), { W, H, shot: SHOT, nopaint: false, dbg });
+  const setup_s = (Date.now() - a) / 1000;
+  const F0 = Math.round(r.t0 * 24), F1 = Math.round(r.t1 * 24);
+  const f0 = +arg('f0', F0), f1 = +arg('f1', F1), start = +arg('start', f0 - F0);
+  const outA = VID ? ['-vf', 'vflip,format=yuv444p', '-c:v', 'libx264', '-preset', 'medium', '-crf', '8', '-g', '48', '-r', '24', VID]
+    : ['-vf', 'vflip', '-start_number', String(start), path.join(DIR, '%04d.png')];
+  const ff = spawn('ffmpeg', ['-hide_banner', '-loglevel', 'error', '-y', '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-s', `${W}x${H}`, '-framerate', '24', '-i', '-', ...outA], { stdio: ['pipe', 'inherit', 'inherit'] });
+  const times = [];
+  for (let f = f0; f < f1; f++) {
+    const b = Date.now();
+    await page.evaluate(async (f) => await window.renderFrame(f), f);
+    const b64 = await page.evaluate((f) => window.finalize(f), f);
+    times.push((Date.now() - b) / 1000);
+    const buf = Buffer.from(b64, 'base64');
+    if (!ff.stdin.write(buf)) await new Promise((res) => ff.stdin.once('drain', res));
+    if (times.length % 24 === 0) console.log(`[${SHOT}] ${f + 1 - f0}/${f1 - f0} mean ${(times.reduce((x, y) => x + y, 0) / times.length).toFixed(2)} s`);
+  }
+  ff.stdin.end(); await new Promise((res) => ff.on('close', res));
+  await browser.close();
+  const mean = times.reduce((x, y) => x + y, 0) / Math.max(1, times.length);
+  const rec = { shot: SHOT, vid: VID, dbg, W, H, f0, f1, start, frames: times.length, setup_s, per_frame_s: { mean: +mean.toFixed(3), max: +Math.max(...times).toFixed(3) }, times };
+  fs.writeFileSync(path.join(DIR, `timing.${SHOT}.${f0}-${f1}.json`), JSON.stringify(rec, null, 1));
+  console.log(JSON.stringify({ shot: SHOT, frames: times.length, per_frame_s: rec.per_frame_s, setup_s }));
+})().catch((e) => { console.error(e); process.exit(1); });
diff --git a/design/m3/ep01/story/shots.js b/design/m3/ep01/story/shots.js
new file mode 100644
index 0000000..7c02ee3
--- /dev/null
+++ b/design/m3/ep01/story/shots.js
@@ -0,0 +1,245 @@
+// Cine Lab · ep01 STORY — shot của tập thử (đoạn 01, tấm nền 03, 04, 19). Nạp qua style.js → EXTRA (chỉ khi dbg.style có giá trị).
+// Cách làm: BỌC shot Last Round (film.js) — dựng nguyên bộ/rig, rồi
+//   (1) ánh xạ thời gian tin = map(t) (tuyến tính từng khúc, luôn tăng → mỗi khung một trạng thái, không khung trùng);
+//   (2) máy mới cỡ trung–xa, chuyển động chậm có easing (smootherstep), hoặc giữ máy gốc + trôi chậm;
+//   (3) sương mũ hai theo độ sâu, hạt bụi trong vùng sáng của ngọn đèn đang cháy, quầng rung (flickAt(f) của bộ phố, f = khung thật);
+//   (4) 'anon': người thắp đèn VÔ DANH dựng trên rig Ida — mũ chóp cao vành rộng + áo khoác dài vạt loe (dáng khác Ida);
+//   (5) sào mồi: thanh nối từ tay trái, đầu sào có than hồng, chạm sát đầu đèn trong khoảng 'pole';
+//   (6) tách bóng khỏi tường: viền sáng 2,75 px quanh toàn bộ bóng (style_v2 b3v3, tham số b3.rimAll — render.js bật mặc định).
+import * as THREE from '/cong3/shared/node_modules/three/build/three.module.js';
+import { SHOTS } from '/cong5/layout/film.js';
+import { buildStreetSet, LAMP_X, LAMP_Z, flickAt } from '/cong5/layout/sets.js';
+import { buildCitySet } from '/cong5/layout/sets2.js';
+import { glowSprite } from '/cong3/dir-C/common.js';
+import { fovOf } from '/cong5/layout/util.js';
+import { P } from '/cong5/layout/common.js';
