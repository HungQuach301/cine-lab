+R0 = np.random.default_rng(19)
+DUST = [(W / 2 + R0.normal(0, 420), H - R0.uniform(-40, 380), R0.uniform(6, 18), R0.uniform(0.2, 0.6), R0.uniform(0, 6.28), R0.uniform(0.3, 1)) for _ in range(140)]
+
+if __name__ == '__main__':
+    out = sys.argv[1]
+    tl, sl, meas = text_layer()
+    meas['vung_an_toan_90'] = {'x': [96, 1824], 'y': [54, 1026]}
+    meas['trong_vung_an_toan'] = (W - meas['dong1_px']) / 2 >= 96 and meas['y_tren'] >= 54 and meas['y_duoi'] <= 1026
+    rng = np.random.default_rng(7)
+    if '--png' in sys.argv:
+        i = int(sys.argv[sys.argv.index('--png') + 2]); Image.fromarray(frame(i, tl, sl, rng)).save(sys.argv[sys.argv.index('--png') + 1])
+    else:
+        ff = subprocess.Popen(['ffmpeg', '-hide_banner', '-loglevel', 'error', '-y', '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-s', f'{W}x{H}', '-framerate', '24', '-i', '-',
+                               '-vf', 'format=yuv444p', '-c:v', 'libx264', '-preset', 'medium', '-crf', '8', '-g', '48', out], stdin=subprocess.PIPE)
