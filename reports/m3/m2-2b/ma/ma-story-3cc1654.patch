+#!/bin/bash
+# Chạy tuần tự nhiều shot, mỗi shot ghi thẳng một clip H.264 (render.js --vid, không PNG — tiết kiệm đĩa).
+# chuoi.sh <thư mục clip> <tên log> "shot[:f0:f1] shot ..."  → <thư mục>/<shot>.mkv (+ timing.*.json); chạy nền: setsid nohup … & disown
+cd "$(dirname "$0")/../../../.."
+D=$1; mkdir -p "$D" /var/tmp/cine-out/ep01/story/log
+for x in $3; do IFS=: read -r s f0 f1 <<< "$x"
+  node design/m3/ep01/story/render.js --shot "$s" --dir "$D" ${f0:+--f0 $f0 --f1 $f1} --vid "$D/$s${f0:+_$f0}.mkv" \
+    > "/var/tmp/cine-out/ep01/story/log/$2_$s${f0:+_$f0}.log" 2>&1
+  echo "$s $(tail -1 /var/tmp/cine-out/ep01/story/log/$2_$s${f0:+_$f0}.log)"
+done
diff --git a/design/m3/ep01/story/ghep_doan.py b/design/m3/ep01/story/ghep_doan.py
new file mode 100644
index 0000000..1ff3627
--- /dev/null
+++ b/design/m3/ep01/story/ghep_doan.py
@@ -0,0 +1,31 @@
+"""Ghép một đoạn từ các clip shot → /var/tmp/cine-out/ep01/sec-m22/<NN>.mkv (H.264 crf 10 yuv444p, -g 48, 24 fps, không tiếng).
+Mờ từ nền tối 6 khung đầu, mờ về nền tối 6 khung cuối (mỗi khung một mức → không khung trùng). Kiểm số khung, ghi <NN>.timing.json, chạy judder.
+python ghep_doan.py <NN> <khung mong đợi> <clip1.mkv> <clip2.mkv> ..."""
+import glob, json, os, subprocess, sys
+NN, EXP, CL = sys.argv[1], int(sys.argv[2]), sys.argv[3:]
+OUT = f'/var/tmp/cine-out/ep01/sec-m22/{NN}.mkv'; os.makedirs(os.path.dirname(OUT), exist_ok=True)   # M2.2: không ghi đè sec/ (bản đã duyệt)
+def nfr(p):
+    r = subprocess.run(['ffprobe', '-v', 'error', '-count_frames', '-select_streams', 'v:0', '-show_entries', 'stream=nb_read_frames', '-of', 'csv=p=0', p], capture_output=True, text=True)
+    return int(r.stdout.strip())
+counts = [nfr(c) for c in CL]
+tot = sum(counts)
+assert tot == EXP, f'tổng khung {tot} != {EXP}: {counts}'
+inp = sum((['-i', c] for c in CL), [])
+fc = ''.join(f'[{i}:v]setpts=PTS-STARTPTS[v{i}];' for i in range(len(CL))) + ''.join(f'[v{i}]' for i in range(len(CL))) + \
+     f'concat=n={len(CL)}:v=1:a=0,fps=24,fade=t=in:s=0:n=6:color=0x0a0c18,fade=t=out:s={EXP - 6}:n=6:color=0x0a0c18,format=yuv444p[o]'
+subprocess.run(['ffmpeg', '-hide_banner', '-loglevel', 'error', '-y', *inp, '-filter_complex', fc, '-map', '[o]', '-an', '-c:v', 'libx264', '-preset', 'medium',
+                '-crf', '10', '-pix_fmt', 'yuv444p', '-g', '48', '-r', '24', OUT], check=True)
+n = nfr(OUT); assert n == EXP, f'{OUT}: {n} khung != {EXP}'
+# giây/khung từ timing.*.json của từng clip (bỏ khung đầu mỗi tiến trình: nạp shader)
+shots = {}
+for c in CL:
+    d = os.path.dirname(c); s = os.path.basename(c)[:-4]
+    for j in glob.glob(os.path.join(d, 'timing.*.json')):
+        r = json.load(open(j))
+        if r['shot'] == s.split('_')[0] and os.path.basename(r.get('vid') or c) == os.path.basename(c):
+            t = r['times'][1:] or r['times']
+            shots[s] = {'khung': r['frames'], 'mean': round(sum(t) / len(t), 2), 'max': round(max(t), 2), 'setup_s': r['setup_s']}
+json.dump({'doan': NN, 'khung': n, 'clip': [os.path.basename(c) for c in CL], 'khung_moi_clip': counts, 'giay_moi_khung': shots}, open(OUT[:-4] + '.timing.json', 'w'), ensure_ascii=False, indent=1)
+j = subprocess.run(['python3', '/home/user/cine-lab/scripts/p/judder.py', OUT], capture_output=True, text=True)
+open(OUT[:-4] + '.judder.json', 'w').write(j.stdout)
+print(json.dumps({'out': OUT, 'khung': n, 'MB': round(os.path.getsize(OUT) / 1e6, 1)}), j.stdout[-600:], j.stderr[-400:])
diff --git a/design/m3/ep01/story/kiem_png.py b/design/m3/ep01/story/kiem_png.py
