+top, mid, bot = np.array([15, 20, 54], np.float32), np.array([30, 30, 66], np.float32), np.array([52, 40, 72], np.float32)
+v = (yy / H)[..., None]
+base = np.where(v < 0.6, top + (mid - top) * (v / 0.6), mid + (bot - mid) * ((v - 0.6) / 0.4))
+vig = 1 - 0.28 * (((xx - W / 2) / (W / 2)) ** 2 + ((yy - H / 2) / (H / 2)) ** 2)[..., None] * 0.5
+base = base * vig
