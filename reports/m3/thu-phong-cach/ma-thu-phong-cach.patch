+    rep('big = texture(tBig, vUv).rgb;', 'big = texture(tBig, vUv).rgb / max(texture(tBig, vUv).a, 0.02);');
+    // (2) bóng ĐẶC: mực phẳng + MỘT viền mảnh (≈ 1,6 px ở 960) ở phía nguồn sáng (hướng = gradient ánh nhoè rộng)
