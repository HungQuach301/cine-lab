+      for (int j=-1;j<=1;j++) for (int i=-1;i<=1;i++) { vec2 q = vUv + vec2(i,j)*px; float w = 1.0 - clamp(texture(tG, q).g, 0.0, 1.0); s += texture(tSrc, q).rgb * w; ws += w; } o = vec4(s/9.0, ws/9.0); }`,
