+        a = p.getchannel('A'); sh = Image.new('RGBA', p.size, (0, 0, 0, 0)); sh.putalpha(a.point(lambda v: int(v * 0.6)))
+        sh = sh.filter(ImageFilter.GaussianBlur(10))
