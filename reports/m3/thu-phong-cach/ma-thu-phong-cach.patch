+        d.rectangle([x, y, x + 190, y + 26], fill=(0, 0, 0)); d.text((x + 6, y + 3), f'{s} khung {fr} · {t}', fill=(255, 255, 255), font=f)
+sheet.save(out, quality=88); print(out)
