+        d.rectangle([x, y0 - hh, x + bw, y0], fill=AMBER, outline=INK, width=6 * K)
+        text(d, (x + bw / 2, y0 - hh - 14 * K), str(v), 80 * K, INK, 'ms'); text(d, (x + bw / 2, y0 + 14 * K), str(yr), 60 * K, INK, 'mt')
+    text(d, (W * K - 40 * K, 760 * K), 'Illustrative data', 48 * K, INK, 'rs')
