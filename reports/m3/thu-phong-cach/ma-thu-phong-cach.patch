+    f = Frame(seed); f.text((96, 260), big, 170, color, 'serifb')
+    for i, l in enumerate(lines): f.text((100, 520 + i * 60), l, 44, PAPER)
+    if sub: f.text((100, 520 + len(lines) * 60 + 20), sub, 34, GREY)
+    src(f, source); return f.save(o)
