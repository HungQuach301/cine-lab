+# Cine Lab · Shorts ep01 — in mốc từ (giây) từ .align.json dạng ký tự của ElevenLabs.
+import json, sys
+def words(p):
+    d = json.load(open(p)); c = d['characters']; s = d['character_start_times_seconds']; e = d['character_end_times_seconds']
+    w = ''; t0 = None; out = []
+    for ch, a, b in zip(c, s, e):
+        if ch.isspace():
+            if w: out.append((w, t0)); w = ''
+        else:
+            if not w: t0 = a
+            w += ch
+    if w: out.append((w, t0))
+    return out, e[-1]
+if __name__ == '__main__':
+    for p in sys.argv[1:]:
+        o, end = words(p); print(' '.join('%s@%.2f' % x for x in o)); print('end', end)
