+// Số khung = ceil((0,6 + cuối lời + 1,5) × 24), cuối lời lấy từ .align.json.
+// node render.js --short S2 [--from 0 --to N] [--out f.mkv] [--only 10,200 --pngdir d] [--plate tệp.png]
