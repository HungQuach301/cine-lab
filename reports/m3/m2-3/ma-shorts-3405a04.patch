+const AL = JSON.parse(fs.readFileSync(`/home/user/cine-lab/${VO}.align.json`)), END = AL.character_end_times_seconds.slice(-1)[0];
+const NF = Math.ceil((0.6 + END + 1.5) * 24 - 1e-9), F0 = +arg('from', 0), F1 = +arg('to', NF);
