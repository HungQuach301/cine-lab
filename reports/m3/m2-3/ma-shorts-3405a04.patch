+# Cine Lab · ep01 SHORTS — ảnh 3 khung (đầu/giữa/cuối) 540×960 của mỗi Short vào /var/tmp/cine-out/ep01/shorts/xem/
+import subprocess
+D = '/var/tmp/cine-out/ep01/shorts'
+for s in ('S1', 'S2', 'S3'):
+    n = int(subprocess.run(['ffprobe', '-v', 'error', '-count_packets', '-select_streams', 'v:0', '-show_entries', 'stream=nb_read_packets', '-of', 'csv=p=0', f'{D}/{s}.mkv'], capture_output=True, text=True).stdout)
+    for f in (24, n // 2, n - 12):
+        subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', f'{D}/{s}.mkv', '-vf', f'select=eq(n\\,{f}),scale=540:960', '-frames:v', '1', f'{D}/xem/{s}_f{f}.png'], check=True)
+    print(s, n)
