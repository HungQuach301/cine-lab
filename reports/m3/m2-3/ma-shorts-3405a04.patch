+  if (PLATE) await page.evaluate(async () => await window.setPlate('/plate.png'));
+  await page.waitForFunction(() => !!window.SEC && window.SEC.short);
+  if (ONLY.length) { for (const f of ONLY) { await page.evaluate((f) => window.drawFrame(f), f); fs.writeFileSync(path.join(PNGDIR, `${S}_f${f}.png`), await page.locator('#c').screenshot()); }
