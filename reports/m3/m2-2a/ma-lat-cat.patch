+  g.strokeRect(-4 * s, -14 * s, 62 * s, 10 * s); g.beginPath(); g.moveTo(16 * s, -9 * s); g.lineTo(38 * s, -9 * s); g.stroke(); g.restore(); }
+
+// ---------- số liệu (KICH-BAN v3 §9.2, chính xác) ----------
+const G1 = [[1950, 97], [1960, 77], [1970, 37]];
+const G3 = [['Word processors and typists', -34.4, 24.40], ['Telephone operators', -27.6, 28.52], ['Switchboard operators, incl. answering service', -26.0, 31.30], ['Data entry keyers', -25.5, 33.00], ['Telemarketers', -21.4, 36.05]];
+const G4 = [['Customer service representatives', -5.0, 58.62], ['Insurance appraisers, auto damage', -9.2, 62.78], ['Claims adjusters, examiners, and investigators', -4.4, 65.66]];
+const G5A = [['Software developers', 17.9, 72.01]];
+const G5B = [['Nurse practitioners', 41.0, 80.03], ['Solar photovoltaic installers', 36.5, 82.41], ['Data scientists', 34.6, 85.33]];
+const SRC = { census: 'Source: U.S. Census Bureau, Historical Statistics of the U.S., Series D 233–682',
+  ep: 'Source: U.S. BLS, Employment Projections 2025–35, Table 1.5',
+  mlr: 'Source: U.S. BLS, Monthly Labor Review, Feb 2025 (2023–33 projections)' };
+
+// ---------- mốc thời gian (giây, đã gồm lệch +1,0 s của lời dẫn) ----------
+const T = { flame: [1354.4, 907.2], dotA: 6.0, dotB: 6.8, dotC: 7.55, storyOut: [6.3, 6.95], paperUp: [6.95, 7.5],
+  g1axis: [7.2, 8.0], g1line: [[8.2, 9.6], [9.7, 11.1]], g2out: [12.0, 13.5], flip: [13.2, 14.3], g2title: 14.2, g2tag: 14.7, g2axis: [15.0, 16.5],
+  barDur: 0.95, c34: [26.62, 27.55], g3b: [38.69, 39.5], pat: [40.4, 41.6],
+  g4: [45.65, 46.9], g4title: 46.3, g4tag: 48.75, g4quote: 51.8, morph: [68.9, 70.4], tagA: 70.6, tagB: 76.1,
+  words: [88.33, 89.68, 90.95], black: [93.0, 93.75] };
+const BLUR = [[5.95, 7.7], [11.95, 14.5], [45.6, 47.0], [68.85, 70.5]];   // cửa sổ motion blur (khung con)
+
+// ---------- toạ độ tấm (cục bộ) ----------
+const L3 = { lab: 470, z: 1430, k: 22, rows: [330, 410, 490, 570, 650], bh: 46, tickY: 708 };   // G3 (và G4 trước biến hình): 0 ở x 1430, −40 % ở x 550
+const L5 = { z: 550 + 40 * (930 / 85), k: 930 / 85 };   // G5: −40 % ở 550, +45 % ở 1480
+const R45 = { rows4: [360, 420, 480], rowA: [540], rowsB: [632, 688, 744], bh: 36 };
+
+let NOTEXT = false;   // P sửa: bản thu nhỏ G3 ở G4–G6 không vẽ chữ (chữ mờ 40 % chỉ đạt 2,05:1 < 4,5:1)
+function text(g, s, x, y, f, color, align = 'left', base = 'alphabetic') { if (NOTEXT) return; g.font = f; g.fillStyle = color; g.textAlign = align; g.textBaseline = base; g.fillText(s, x, y); }
+function wrap(g, s, maxW, f) { g.font = f; if (g.measureText(s).width <= maxW) return [s]; const w = s.split(' '); let a = '', out = [];
+  for (const x of w) { const n = a ? a + ' ' + x : x; if (g.measureText(n).width > maxW && a) { out.push(a); a = x; } else a = n; } out.push(a); return out; }
+function tag(g, s, x, y, fill, color, f, a = 1, dash = false, align = 'left') { g.save(); g.globalAlpha *= a; g.font = f; const w = g.measureText(s).width + 28, h = 38;
