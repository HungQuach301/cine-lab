+ffprobe -v error -show_entries stream=width,height,bit_rate -show_entries format=duration -of compact ll-ep01-lat-cat-720p.mp4
+/opt/cine/bin/python /home/user/cine-lab/.claude/worktrees/agent-aa29263033136d9fe/design/m3/lat-cat/tuong_phan.py ll-ep01-lat-cat.mp4
+/opt/cine/bin/python /home/user/cine-lab/.claude/worktrees/agent-aa29263033136d9fe/design/m3/lat-cat/tuong_phan.py ll-ep01-lat-cat-720p.mp4 | tail -1
+# im số tuyệt đối giữa đoạn (−90 dB, ≥ 50 ms) trên âm thanh cuối
