+      pts = new THREE.Points(g, new THREE.PointsMaterial({ size: 0.035, map: dt, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, color: new THREE.Color('#ffd49a').multiplyScalar(1.6), sizeAttenuation: true, fog: false }));
+      pts.userData.noG = 1; pts.frustumCulled = false; sc.add(pts);
+    }
+    const cam = new THREE.PerspectiveCamera(fovOf(35), ctx.W / ctx.H, 0.1, 400);
+    const p0 = new THREE.Vector3(...BR.cam0.pos), p1 = new THREE.Vector3(...BR.cam1.pos), l0 = new THREE.Vector3(...BR.cam0.look), l1 = new THREE.Vector3(...BR.cam1.look);
+    const pp = new THREE.Vector3(), ll = new THREE.Vector3(), v = new THREE.Vector3();
+    const gc0 = L.gc.material.color.clone(), gw0 = L.gw.material.color.clone();
+    return { scene: sc, cam, named: {}, exposure: 1.15,
+      update(t, T, f) {
+        st.setState({ gas: (i) => (i === BR.lamp ? 1 : 0), post: () => 0, square: 0, clock: 0, whiteFill: 0.0 }, f);
+        // máy: nâng chậm, easing hai đầu (smootherstep), toạ độ liên tục
+        const u0 = Math.max(0, Math.min(1, t / BR.t1)), u = u0 * u0 * u0 * (u0 * (u0 * 6 - 15) + 10);
+        pp.lerpVectors(p0, p1, u); ll.lerpVectors(l0, l1, ease(Math.min(1, u0 * 1.05)));
