@@ -0,0 +1,35 @@
+"""Cine Lab · M2.2a — phụ đề EN (.srt, không cháy vào hình) từ mốc ký tự của lời dẫn (lệch +1,0 s).
+Cắt theo câu; câu dài chia ở dấu phẩy/hai chấm gần giữa để mỗi cue ≤ 2 dòng × 42 ký tự.
+python3 design/m3/lat-cat/phu_de.py <align.json> <ra.srt>
+"""
+import json, sys, textwrap
+OFF, MAXC = 1.0, 84
+al = json.load(open(sys.argv[1])); C, S, E = al['characters'], al['character_start_times_seconds'], al['character_end_times_seconds']
+txt = ''.join(C)
+# câu: kết thúc ở . : ? ! theo sau khoảng trắng hoặc hết chuỗi (không cắt "U.S.")
+cues, i0 = [], 0
+for i, c in enumerate(txt):
+    end = i == len(txt) - 1 or (c in '.?!' and txt[i + 1] in ' \n' and txt[max(0, i - 3):i + 1] not in ('U.S.',) and not txt[max(0, i - 1):i + 1] == 'S.')
+    if end:
+        cues.append((i0, i + 1)); i0 = i + 1
+def split(a, b):
+    s = txt[a:b].strip()
+    if len(s) <= MAXC: return [(a, b)]
+    mid = (a + b) // 2; best = None
+    for j in range(a + 10, b - 10):
+        if txt[j] in ',:' and txt[j + 1] == ' ' and (best is None or abs(j - mid) < abs(best - mid)): best = j
+    if best is None: best = txt.rfind(' ', a, mid)
+    return split(a, best + 1) + split(best + 1, b)
+out = []
+for a, b in cues:
+    for x, y in split(a, b):
+        while x < y and txt[x].isspace(): x += 1
+        while y > x and txt[y - 1].isspace(): y -= 1
+        if x < y: out.append((S[x] + OFF, E[y - 1] + OFF, txt[x:y]))
+def ts(t): ms = int(round(t * 1000)); return f'{ms // 3600000:02d}:{ms // 60000 % 60:02d}:{ms // 1000 % 60:02d},{ms % 1000:03d}'
+with open(sys.argv[2], 'w') as f:
+    for k, (a, b, s) in enumerate(out):
+        nb = out[k + 1][0] - 0.05 if k + 1 < len(out) else b + 0.8
+        b2 = min(max(b + 0.35, a + 1.2), nb)   # giữ thêm ≤ 0,35 s để kịp đọc, không chồng cue sau
+        f.write(f'{k + 1}\n{ts(a)} --> {ts(b2)}\n' + '\n'.join(textwrap.wrap(s, 42)) + '\n\n')
+print(len(out), 'cue')
