+// Chiều sâu (cờ của shot, mặc định bật; dbg.br10 = { fog:0, dust:0, halo:0 } để tắt từng phần):
+//  - ≥ 3 lớp parallax: (1) cột đèn L10 + quầng ở 8 m; (2) hai dãy mặt tiền phố 6–26 m; (3) khối văn phòng 70 m + trời.
+//  - sương theo độ sâu: THREE.Fog sáng hơn (10–95 m) + lớp sương trôi 2D ở bộ ghép.
+//  - quầng đèn rung nhẹ: biên độ ≈ 3 % (tổng hai sin 0,55 Hz + 1,3 Hz), không nhảy bậc.
+//  - hạt bụi/sương trôi trong vùng sáng của L10 (Points, vị trí là hàm liên tục của t → tất định).
+import * as THREE from '/cong3/shared/node_modules/three/build/three.module.js';
+import { buildStreetSet, LAMP_X } from '/cong5/layout/sets.js';
+import { ease, fovOf } from '/cong5/layout/util.js';
+
+export const BR = {
+  lamp: 10, t1: 7.5,
+  cam0: { pos: [30.0, 1.3, -2.4], look: [21.0, 2.3, -3.3] },
+  cam1: { pos: [29.4, 4.3, -2.1], look: [-10.0, 8.2, -2.0] },
+  office: { x: -40, w: 64, h: 40, d: 14 },
+};
+
+function officeTex(seed = 7) {
+  const cv = document.createElement('canvas'); cv.width = 1024; cv.height = 768; const g = cv.getContext('2d');
+  g.fillStyle = '#23252e'; g.fillRect(0, 0, 1024, 768);
