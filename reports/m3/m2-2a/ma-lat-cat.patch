+// Cine Lab · M2.2a LÁT CẮT — bộ dựng đồ hoạ dữ liệu động G0→G6 (canvas2D, vẽ lại MỖI khung, t = khung/24 tất định).
+// Chạy trong Chromium (dohoa_render.js nạp tệp này). window.drawFrame(f) vẽ khung f lên canvas 1920×1080.
+// Ngôn ngữ B3 (bo_mau.py): giấy ngà có vân + mép, bóng đổ của tấm giấy theo vị trí ánh rọi, ánh đèn rọi ấm lướt chậm, giấy lay rất nhẹ, bụi trong ánh rọi.
+// Luật so sánh (CHUAN-KENH-LL §3): G1 THỰC TẾ (nét liền, nhãn ACTUAL) ở khung riêng; G3–G5 DỰ BÁO (gạch chéo + viền nét đứt + nhãn PROJECTION + kỳ).
+// G3, G4 cùng thang 0 → −40 % (22 px/%); G5 trục hai chiều −40 → +45 % biến hình liền từ G4.
+// Màu (v2 §7): hổ phách = khí / nghề tăng; trắng lạnh / thép lạnh = nghề giảm / điện. Font DejaVu (RIGHTS C4-F1, M2-F-DejaVuSans-Bold, M2-F-DejaVuSerif-Bold).
+'use strict';
+const W = 1920, H = 1080, FPS = 24;
+const cv = document.getElementById('c'), X = cv.getContext('2d');
+const COLD_T = '#2b405c';   // chữ số lớn màu lạnh (đậm hơn COLD để tương phản ≥ 6:1 cả trong vùng ánh rọi)
+const INK = '#211a17', INK2 = '#4a3f36', CREAM = '#ecdfbe', AMBER = '#c47026', AMBER_L = '#d99a52', COLD = '#3f5a7a', NAVY = '#141a2e', COLDW = '#eef3ff', OCHRE = '#6b3a12';
+const SANS = '"DejaVu Sans"', SANSB = 'bold 1px "DejaVu Sans"', SERIFB = '"DejaVu Serif"';
+const font = (px, kind = 'sans', bold = false) => `${bold ? 'bold ' : ''}${px}px ${kind === 'serif' ? SERIFB : SANS}`;
+const M = '−';   // dấu trừ
+const SX = 150, SY = 90, SW = 1620, SH = 900;   // tấm giấy (toạ độ khung)
+const DUR = 93.75;
+
+// ---------- tiện ích thời gian ----------
+const cl = (u) => Math.max(0, Math.min(1, u));
+const sm = (u) => { u = cl(u); return u * u * u * (u * (u * 6 - 15) + 10); };   // smootherstep
+const eo = (u) => { u = cl(u); return 1 - Math.pow(1 - u, 3); };
+const pr = (t, a, b) => cl((t - a) / (b - a));
+const lerp = (a, b, u) => a + (b - a) * u;
+const fmt1 = (v) => (v < 0 ? M : v > 0 ? '+' : '') + Math.abs(v).toFixed(1) + '%';
+
+// ---------- RNG tất định ----------
+function rng(seed) { let s = seed >>> 0 || 1; return () => (s = (s * 16807) % 2147483647) / 2147483647; }
+
+// ---------- vân giấy (một lần, tất định) ----------
+function paperTex(w, h, seed) {
+  const c = document.createElement('canvas'); c.width = w; c.height = h; const g = c.getContext('2d'); const R = rng(seed);
+  g.fillStyle = CREAM; g.fillRect(0, 0, w, h);
+  const id = g.getImageData(0, 0, w, h), d = id.data;
+  for (let i = 0; i < d.length; i += 4) { const n = (R() - 0.5) * 9; d[i] += n; d[i + 1] += n; d[i + 2] += n * 0.8; }
+  g.putImageData(id, 0, 0);
+  for (let i = 0; i < 1400; i++) {   // sợi giấy
+    const x = R() * w, y = R() * h, L = 6 + R() * 26, a = R() * Math.PI;
+    g.strokeStyle = `rgba(${R() < 0.5 ? '120,95,60' : '255,250,235'},${0.05 + R() * 0.07})`; g.lineWidth = 0.6 + R() * 0.8;
+    g.beginPath(); g.moveTo(x, y); g.quadraticCurveTo(x + Math.cos(a) * L * 0.5 + (R() - 0.5) * 4, y + Math.sin(a) * L * 0.5 + (R() - 0.5) * 4, x + Math.cos(a) * L, y + Math.sin(a) * L); g.stroke();
+  }
+  for (let i = 0; i < 26; i++) {   // vết loang
+    const x = R() * w, y = R() * h, r = 40 + R() * 160, gr = g.createRadialGradient(x, y, 0, x, y, r);
+    gr.addColorStop(0, `rgba(150,110,60,${0.025 + R() * 0.03})`); gr.addColorStop(1, 'rgba(150,110,60,0)'); g.fillStyle = gr; g.fillRect(x - r, y - r, 2 * r, 2 * r);
+  }
+  const e = g.createLinearGradient(0, 0, 0, h); e.addColorStop(0, 'rgba(90,60,30,0.10)'); e.addColorStop(0.06, 'rgba(90,60,30,0)'); e.addColorStop(0.94, 'rgba(90,60,30,0)'); e.addColorStop(1, 'rgba(90,60,30,0.12)'); g.fillStyle = e; g.fillRect(0, 0, w, h);
+  const e2 = g.createLinearGradient(0, 0, w, 0); e2.addColorStop(0, 'rgba(90,60,30,0.10)'); e2.addColorStop(0.04, 'rgba(90,60,30,0)'); e2.addColorStop(0.96, 'rgba(90,60,30,0)'); e2.addColorStop(1, 'rgba(90,60,30,0.10)'); g.fillStyle = e2; g.fillRect(0, 0, w, h);
+  return c;
+}
+// mép giấy hơi răng cưa (đường bao tất định)
+function edgePath(w, h, seed) { const R = rng(seed), p = []; const step = 18;
+  for (let x = 0; x <= w; x += step) p.push([x, (R() - 0.5) * 2.2]);
+  for (let y = 0; y <= h; y += step) p.push([w + (R() - 0.5) * 2.2, y]);
+  for (let x = w; x >= 0; x -= step) p.push([x, h + (R() - 0.5) * 2.2]);
+  for (let y = h; y >= 0; y -= step) p.push([(R() - 0.5) * 2.2, y]); return p; }
+const PAPER = [paperTex(SW, SH, 11), paperTex(SW, SH, 29)], EDGE = [edgePath(SW, SH, 5), edgePath(SW, SH, 8)];
+// nền: tường/bàn tối, vân thô
+const BG = (() => { const c = document.createElement('canvas'); c.width = W; c.height = H; const g = c.getContext('2d'); const R = rng(77);
+  const gr = g.createLinearGradient(0, 0, 0, H); gr.addColorStop(0, '#171b2b'); gr.addColorStop(1, '#0d0f19'); g.fillStyle = gr; g.fillRect(0, 0, W, H);
+  for (let i = 0; i < 5000; i++) { g.fillStyle = `rgba(${R() < 0.5 ? '0,0,0' : '120,110,140'},${0.04 + R() * 0.05})`; g.fillRect(R() * W, R() * H, 1 + R() * 2, 1 + R() * 2); }
+  return c; })();
+// mẫu gạch chéo
+function hatch(color, bg) { const c = document.createElement('canvas'); c.width = c.height = 14; const g = c.getContext('2d');
+  g.fillStyle = bg; g.fillRect(0, 0, 14, 14); g.strokeStyle = color; g.lineWidth = 3.2;
+  for (const o of [-14, 0, 14]) { g.beginPath(); g.moveTo(o, 14); g.lineTo(o + 14, 0); g.stroke(); } return X.createPattern(c, 'repeat'); }
+const HATCH_COLD = hatch(COLD, 'rgba(63,90,122,0.18)'), HATCH_AMB = hatch(AMBER_L, 'rgba(217,154,82,0.22)');
