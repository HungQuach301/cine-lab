+  for (let r = 0; r <= rows; r++) { g.fillStyle = '#181a22'; g.fillRect(0, r * rh - 3, 1024, 6); }   // gờ tầng
+  const t = new THREE.CanvasTexture(cv); t.colorSpace = THREE.SRGBColorSpace; return t;
+}
+export const BR10_SHOT = { id: 'br10', scene: 10, t0: 0, t1: BR.t1, size: 'WS', angle: 'thấp → nâng', mm: 35, move: 'crane up chậm (easing)',
+  why: 'Đoạn 10: đèn khí của Ida còn cháy ở cuối phố; phía sau, khối văn phòng sáng đèn điện (cầu nối sang đồ hoạ dữ liệu).',
+  async build(ctx) {
+    const F = Object.assign({ fog: 1, dust: 1, halo: 1 }, (ctx.dbg && ctx.dbg.br10) || {});
+    const st = buildStreetSet({ sky: 'night', x0: 4, x1: 46, shadowLamps: [BR.lamp], fog: [30, 150] });
+    const sc = st.scene;
+    // (3) hậu cảnh: khối văn phòng, mặt quay về +x (về phía máy), cửa sổ trắng lạnh
