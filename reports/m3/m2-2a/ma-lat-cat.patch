+    const body = new THREE.Mesh(new THREE.BoxGeometry(O.d, O.h, O.w), new THREE.MeshLambertMaterial({ color: '#1c1e27' })); body.position.set(O.x - O.d / 2 - 0.01, O.h / 2, 0); sc.add(body);
+    const spill = new THREE.PointLight('#e3eaff', 30, 40, 1.4); spill.position.set(O.x + 6, 16, 0); sc.add(spill);   // ánh điện hắt nhẹ lên đầu hồi xa
+    // sương theo độ sâu: tấm dọc vuông góc trục nhìn, xa hơn → đặc hơn
+    // sương theo độ sâu (cờ fog): sương tuyến tính sáng hơn bộ phố gốc → tiền cảnh rõ, mặt tiền mờ dần, khối văn phòng chìm ≈ 40 %.
+    // (Tấm sương 3D thử trước bị lớp B3 vẽ thành sọc ngang → bỏ; lớp sương trôi 2D đặt ở bộ ghép, design/m3/lat-cat/dohoa.html.)
+    if (F.fog) sc.fog = new THREE.Fog('#323a5c', 10, 140);
