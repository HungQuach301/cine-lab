+// Cine Lab · M2.2a — trình điều khiển render đồ hoạ dữ liệu (dohoa.js) trong Chromium Playwright, từng khung, tất định.
+// node design/m3/lat-cat/dohoa_render.js --out <tệp.mkv> --from 0 --to 2250 [--story <thư mục png khung truyện %04d.png>] [--png 0,170,...] [--pngdir d]
+// Xuất đoạn khung [from, to) dạng FFV1 không mất (ghép đoạn song song sau); ghi <out>.timing.json (giây/khung: vẽ + lấy điểm ảnh).
+const { chromium } = require('/opt/pw/node_modules/playwright');
+const { spawn } = require('child_process');
+const fs = require('fs'), path = require('path');
+const arg = (k, d) => { const i = process.argv.indexOf('--' + k); return i > 0 ? process.argv[i + 1] : d; };
+const OUT = path.resolve(arg('out')), F0 = +arg('from', 0), F1 = +arg('to', 2250), STORY = arg('story', null);
+const PNGS = (arg('png', '') || '').split(',').filter(Boolean).map(Number), PNGDIR = arg('pngdir', path.dirname(OUT));
+(async () => {
+  const browser = await chromium.launch({ args: ['--disable-gpu', '--font-render-hinting=none', '--force-color-profile=srgb'] });
+  const page = await browser.newPage({ viewport: { width: 1920, height: 1080 }, deviceScaleFactor: 1 });
+  page.on('pageerror', (e) => console.error('[pageerror]', e.message)); page.on('console', (m) => console.error('[page]', m.text()));
+  await page.route('http://dohoa.local/**', (route) => { const u = decodeURIComponent(new URL(route.request().url()).pathname);
+    if (u === '/index.html') return route.fulfill({ status: 200, contentType: 'text/html; charset=utf-8', body: '<!doctype html><html><head><meta charset="utf-8"></head><body style="margin:0;background:#000"><canvas id="c" width="1920" height="1080"></canvas><script src="/dohoa.js"></script></body></html>' });
+    if (u === '/dohoa.js') return route.fulfill({ status: 200, contentType: 'text/javascript; charset=utf-8', body: fs.readFileSync(path.join(__dirname, 'dohoa.js')) });
+    if (u.startsWith('/story/') && STORY) { const p = path.join(STORY, path.basename(u)); if (fs.existsSync(p)) return route.fulfill({ status: 200, contentType: 'image/png', body: fs.readFileSync(p) }); }
+    route.fulfill({ status: 404, body: 'nf' }); });
+  await page.goto('http://dohoa.local/index.html'); await page.waitForFunction(() => window.READY === true);
+  const ff = spawn('ffmpeg', ['-hide_banner', '-loglevel', 'error', '-y', '-f', 'rawvideo', '-pix_fmt', 'rgba', '-s', '1920x1080', '-framerate', '24', '-i', '-',
+    '-c:v', 'ffv1', '-level', '3', '-pix_fmt', 'bgr0', OUT], { stdio: ['pipe', 'inherit', 'inherit'] });
+  const times = [];
+  for (let f = F0; f < F1; f++) {
+    const b = Date.now();
+    if (STORY) await page.evaluate(async (u) => await window.setStory(u), f < 180 ? `/story/${String(f).padStart(4, '0')}.png` : null);
+    const b64 = await page.evaluate((f) => { window.drawFrame(f); const d = document.getElementById('c').getContext('2d').getImageData(0, 0, 1920, 1080).data;
+      let s = ''; const CH = 0x8000; for (let i = 0; i < d.length; i += CH) s += String.fromCharCode.apply(null, d.subarray(i, i + CH)); return btoa(s); }, f);
+    const buf = Buffer.from(b64, 'base64'); times.push((Date.now() - b) / 1000);
+    if (!ff.stdin.write(buf)) await new Promise((r) => ff.stdin.once('drain', r));
+    if (PNGS.includes(f)) { const p = spawn('ffmpeg', ['-v', 'error', '-y', '-f', 'rawvideo', '-pix_fmt', 'rgba', '-s', '1920x1080', '-i', '-', '-frames:v', '1', path.join(PNGDIR, `dohoa_f${f}.png`)]); p.stdin.end(buf); }
+    if ((f - F0) % 100 === 0) console.error(`[dohoa] ${f}/${F1} ${times[times.length - 1].toFixed(2)} s`);
+  }
+  ff.stdin.end(); await new Promise((r) => ff.on('close', r)); await browser.close();
+  const mean = times.reduce((a, b) => a + b, 0) / times.length;
+  fs.writeFileSync(OUT + '.timing.json', JSON.stringify({ from: F0, to: F1, frames: times.length, per_frame_s: { mean: +mean.toFixed(3), max: +Math.max(...times).toFixed(3) }, times }, null, 0));
+  console.log(JSON.stringify({ from: F0, to: F1, mean: +mean.toFixed(3), max: +Math.max(...times).toFixed(3) }));
+})().catch((e) => { console.error(e); process.exit(1); });
