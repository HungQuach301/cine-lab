+"""Cine Lab · M2.2a — đo tương phản chữ TRÊN CHÍNH mp4 lát cắt (cách đo như tuong_phan_clip.py: tỉ lệ WCAG).
+Chữ tối trên nền sáng: chữ = trung vị 3 % điểm tối nhất, nền = trung vị 40 % điểm sáng nhất trong ô; chữ sáng trên nền tối: ngược lại.
+/opt/cine/bin/python design/m3/lat-cat/tuong_phan.py <mp4> [<ảnh ghép ô.png>]   (toạ độ ô theo khung 1920×1080; mp4 khác cỡ thì co tỉ lệ)
+"""
+import io, json, subprocess, sys
+import numpy as np
+from PIL import Image
+v = sys.argv[1]
+def lin(c): c = c / 255.0; return np.where(c <= 0.03928, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)
+def L(rgb): r, g, b = lin(np.array(rgb, float)); return 0.2126 * r + 0.7152 * g + 0.0722 * b
+def ratio(a, b): la, lb = L(a), L(b); return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)
+BOX = [  # (giây, tên, (x0, y0, x1, y1), 'dark' | 'light' = chữ tối / chữ sáng)
+    (11.5, 'G1 tiêu đề', (210, 140, 900, 192), 'dark'), (11.5, 'G1 nhãn ACTUAL', (1250, 136, 1700, 170), 'dark'),
+    (11.5, 'G1 nhãn trục "100k"', (330, 278, 402, 302), 'dark'), (11.5, 'G1 chú thích định nghĩa nghề', (408, 856, 885, 880), 'dark'),
+    (11.5, 'G1 dòng nguồn', (208, 940, 820, 966), 'dark'), (11.5, 'G1 số lớn "37k"', (1448, 478, 1690, 564), 'dark'),
+    (35.0, 'G3 nhãn PROJECTION (nền navy)', (1330, 138, 1706, 167), 'light'), (35.0, 'G3 số lớn "−34%"', (698, 248, 1010, 348), 'dark'),
+    (35.0, 'G3 nhãn hàng 1', (330, 406, 622, 436), 'dark'), (35.0, 'G3 giá trị "−34.4%"', (700, 404, 815, 438), 'dark'),
+    (35.0, 'G3 nhãn trục "−40%"', (668, 798, 734, 824), 'dark'), (35.0, 'G3 dòng nguồn', (208, 940, 760, 966), 'dark'),
+    (44.0, 'G3b "same pattern"', (298, 282, 625, 334), 'dark'),
+    (60.0, 'G4 nhãn kỳ 2023–33 (nền nâu)', (762, 122, 1100, 151), 'light'), (60.0, 'G4 trích dẫn MLR', (748, 250, 1310, 276), 'dark'),
+    (60.0, 'G4 tiêu đề', (748, 180, 1300, 232), 'dark'),
+    (87.0, 'G5 giá trị "+41.0%"', (1594, 706, 1705, 738), 'dark'), (87.0, 'G5 nhãn nhóm 2025–35 (nền nâu)', (220, 678, 525, 703), 'light'),
+    (87.0, 'G5 dòng nguồn 2', (208, 954, 760, 976), 'dark'), (92.0, 'G6 chữ "change"', (790, 380, 950, 432), 'dark'),
+    (60.0, 'G3 thu nhỏ (mờ 40 %, trang trí) "−34%"', (352, 162, 448, 198), 'dark'),
+]
+res, crops = [], []
+for t, name, b, kind in BOX:
+    r = subprocess.run(['ffmpeg', '-nostdin', '-v', 'error', '-ss', f'{t}', '-i', v, '-frames:v', '1', '-f', 'image2pipe', '-vcodec', 'png', '-'], capture_output=True, check=True)
+    im = Image.open(io.BytesIO(r.stdout)).convert('RGB'); s = im.width / 1920; bb = tuple(int(round(x * s)) for x in b)
+    a = np.asarray(im.crop(bb)).reshape(-1, 3).astype(int); o = np.argsort(a.sum(1)); n = len(o)
+    lo, hi = a[o[: max(1, n * 3 // 100)]], a[o[-n * 40 // 100:]]
+    if kind == 'light': lo, hi = a[o[: n * 40 // 100]], a[o[-max(1, n * 3 // 100):]]
+    fg = np.median(lo if kind == 'dark' else hi, axis=0); bg = np.median(hi if kind == 'dark' else lo, axis=0)
+    q = ratio(fg, bg); res.append(dict(t=t, name=name, ratio=round(float(q), 2), fg=[int(x) for x in fg], bg=[int(x) for x in bg])); crops.append(im.crop(bb))
+    print(f'{t:6.1f}s  {q:5.2f}:1  {name}')
+info = [x for x in res if 'trang trí' not in x['name']]
+print(json.dumps({'min_thong_tin': min(x['ratio'] for x in info), 'min_ten': min(info, key=lambda x: x['ratio'])['name']}, ensure_ascii=False))
+if len(sys.argv) > 2:
+    Wd = max(c.width for c in crops); Hh = sum(c.height + 4 for c in crops); g = Image.new('RGB', (Wd, Hh), (255, 0, 255)); y = 0
+    for c in crops: g.paste(c, (0, y)); y += c.height + 4
+    g.save(sys.argv[2])
