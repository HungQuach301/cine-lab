+"""Cine Lab · M2.2a LÁT CẮT — dựng âm thanh (tất định): lời dẫn Bill nguyên bản (lệch +1,0 s, chỉ lọc thấp + nén nhẹ, KHÔNG atempo,
+không cắt), nhạc M2-MUS-1 hạ 12 dB khi có lời (đường bao tính từ mốc ký tự), SFX CC0 (fade 8 ms), master −14 LUFS / TP ≤ −1 dBTP.
+/opt/cine/bin/python design/m3/lat-cat/am_thanh.py <vo.mp3> <align.json> <nhạc.mp3> <thư mục sfx> <ra.wav>
+Ghi <ra>.json: khoảng lời, mức hạ thật đo trên stem nhạc, vị trí SFX.
+"""
+import json, subprocess, sys
+import numpy as np
+SR, DUR, OFF = 48000, 93.75, 1.0
+vo_p, al_p, mus_p, sfx_d, out_p = sys.argv[1:6]
+
+
+def dec(p, ch, af=None, ss=None, t=None):
+    cmd = ['ffmpeg', '-v', 'error', '-nostdin']
+    if ss is not None: cmd += ['-ss', str(ss)]
+    if t is not None: cmd += ['-t', str(t)]
+    cmd += ['-i', p] + (['-af', af] if af else []) + ['-ac', str(ch), '-ar', str(SR), '-f', 'f32le', '-']
+    a = np.frombuffer(subprocess.run(cmd, capture_output=True, check=True).stdout, np.float32)
+    return a.reshape(-1, ch).astype(np.float64)
+
+
+N = int(round(DUR * SR))
+mix = np.zeros((N, 2))
+# 1) lời dẫn: lọc thấp 70 Hz + nén nhẹ (3:1 trên −26 dB), đặt ở +1,0 s
+vo = dec(vo_p, 1, 'highpass=f=70,acompressor=threshold=-26dB:ratio=3:attack=6:release=160:knee=4')[:, 0]
+i0 = int(OFF * SR); vo_st = np.zeros(N); vo_st[i0:i0 + len(vo)] = vo[: N - i0]
+# 2) khoảng có lời từ mốc ký tự (gộp khe < 0,55 s)
+al = json.load(open(al_p)); cs, ce, ch = al['character_start_times_seconds'], al['character_end_times_seconds'], al['characters']
+seg = []
+for c, a, b in zip(ch, cs, ce):
+    if c.isspace(): continue
+    a, b = a + OFF, b + OFF
+    if seg and a - seg[-1][1] < 0.55: seg[-1][1] = max(seg[-1][1], b)
+    else: seg.append([a, b])
+# 3) nhạc: đường bao dB (0 ở chỗ lặng, −12 khi có lời; dốc 0,2 s trước khi vào lời, 0,25 s sau khi hết lời)
+DUCK, BASE = -12.0, -3.0
+t = np.arange(N) / SR; env = np.zeros(N)
+for a, b in seg:
+    u = np.clip(np.minimum((t - (a - 0.2)) / 0.2, ((b + 0.25) - t) / 0.25), 0, 1); u = u * u * (3 - 2 * u)
+    env = np.minimum(env, DUCK * u)
+fade = np.clip(t / 1.2, 0, 1) * np.clip((DUR - t) / 1.15, 0, 1)   # vào 1,2 s; ra 1,15 s (khớp nhúng đen 93,0–93,75)
+mus = dec(mus_p, 2, ss=0, t=DUR)[:N]
+mus_st = mus * (10 ** ((BASE + env) / 20))[:, None] * fade[:, None]
+# 4) SFX CC0 (Freesound): (tệp, giây bắt đầu trong tệp, độ dài, giây đặt trên phim, gain dB)
+SFX = [('159386.mp3', 2.0, 7.3, 0.0, -17.0, 'đèn khí xì (G0), mờ ra 6,2–7,3 s'),
+       ('470189.mp3', 0.0, 0.37, 12.05, 4.0, 'giấy trượt (G1 rời khung)'),
+       ('320149.mp3', 3.55, 0.85, 13.15, -10.0, 'lật giấy (G2 vào)'),
+       ('470189.mp3', 0.0, 0.37, 45.7, 2.0, 'giấy trượt (G3 thu nhỏ lên góc)'),
+       ('470189.mp3', 0.0, 0.37, 68.95, 0.0, 'giấy trượt (trục G4 → G5)')]
+sfx_log = []
+for f, ss, d, at, g, why in SFX:
+    s = dec(f'{sfx_d}/{f}', 2, ss=ss, t=d); n = len(s); fl = int(0.008 * SR)
+    w = np.ones(n); w[:fl] = np.linspace(0, 1, fl); w[-fl:] = np.linspace(1, 0, fl)
+    if f == '159386.mp3':   # hơi xì kéo dài: vào 0,4 s, ra 1,1 s
+        tt = np.arange(n) / SR; w *= np.clip(tt / 0.4, 0, 1) * np.clip((d - tt) / 1.1, 0, 1)
+    k = int(at * SR); m = min(n, N - k); mix[k:k + m] += (s[:m] * w[:m, None]) * 10 ** (g / 20)
+    sfx_log.append(dict(file=f, src_ss=ss, dur=d, at=at, gain_db=g, note=why, fade_ms=8))
+VO_G = 9.0   # đưa lời lên gần mức đích trước khi chuẩn hoá chung
+mix += vo_st[:, None] * 10 ** (VO_G / 20) + mus_st
+mix = mix.astype(np.float32)
+raw = out_p.replace('.wav', '.pre.wav')
+subprocess.run(['ffmpeg', '-v', 'error', '-y', '-f', 'f32le', '-ar', str(SR), '-ac', '2', '-i', '-', '-c:a', 'pcm_f32le', raw], input=mix.tobytes(), check=True)
+
+
+def meas(p):
+    r = subprocess.run(['ffmpeg', '-nostats', '-i', p, '-af', 'ebur128=peak=true', '-f', 'null', '-'], capture_output=True, text=True).stderr
+    s = r[r.rfind('Summary:'):]; g = lambda k: float(s.split(k)[1].split()[0])
+    return dict(I=g('I:'), LRA=g('LRA:'), TP=g('Peak:'))
+
+
+m0 = meas(raw); gain = -14.0 - m0['I']
+# 5) master: gain tới −14 LUFS rồi giới hạn đỉnh trên tín hiệu nâng mẫu ×4 (xấp xỉ true peak), về 48 kHz
+subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', raw, '-af', f'volume={gain:.3f}dB,aresample=192000,alimiter=limit=0.83:attack=1:release=60:level=disabled,aresample=48000',
+                '-c:a', 'pcm_s24le', out_p], check=True)
+m1 = meas(out_p)
+# mức hạ nhạc thật: RMS stem nhạc (trước fade) trong vùng có lời so với vùng lặng (≥ 0,6 s sau dốc)
+musr = mus * (10 ** ((BASE + env) / 20))[:, None]
+inside = env <= DUCK + 0.01; quiet = (env >= -1.0) & (t > 1.2) & (t < DUR - 1.2)
+db = lambda x: 10 * np.log10(np.mean(x ** 2) + 1e-20)
+duck_meas = db(musr[inside]) - db(musr[quiet])
+duck_env = db(musr[inside]) - db(mus[inside] * 10 ** (BASE / 20))
+rec = dict(segments=seg, pre=m0, gain_db=round(gain, 2), master=m1, duck_env_db=DUCK, duck_meas_same_samples_db=round(duck_env, 2),
+           music_rms_speech_minus_lull_db=round(duck_meas, 2), sfx=sfx_log, vo_gain_db=VO_G)
+json.dump(rec, open(out_p.replace('.wav', '.json'), 'w'), indent=1, ensure_ascii=False)
+print(json.dumps({k: rec[k] for k in ('pre', 'gain_db', 'master', 'duck_meas_same_samples_db', 'music_rms_speech_minus_lull_db')}))
